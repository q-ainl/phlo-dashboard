prop lang => 'en'
prop token => %cookies->token ??= token(20)
prop title = 'Phlo Dashboard'
prop themeColor = 'black'
prop theme => %session->theme ?? 'ionstorm'
prop trans => %session->trans ?? 'ripple'
prop version = '1.3.1'
prop model = 'gpt-4o-mini'
prop publicPaths = ['api']

prop models => array_values(array_filter(['visitor', 'domain', 'user', 'subscription'], fn($m) => phlo_exists($m)))
prop menu => $this->navMenu

method navMenu {
	$u = auth::user()
	if (!$u) return []
	$full = [
		'visitor'  => ['icon' => '👁️', 'uri' => 'visitors', 'title' => 'Visitors', 'admin' => true],
		'dbadmin'  => ['icon' => '🛢️', 'uri' => 'dbadmin',  'title' => 'Database', 'admin' => true],
		'overview' => ['icon' => '🏠', 'uri' => 'overview', 'title' => 'Overview', 'admin' => false],
		'graph'    => ['icon' => '🕸️', 'uri' => 'graph', 'title' => 'Graph', 'admin' => false],
		'domain'   => ['icon' => '🌍', 'uri' => 'domains',  'title' => 'Domains', 'admin' => true],
		'site'     => ['icon' => '🌐', 'uri' => 'sites',    'title' => 'Sites', 'admin' => true],
		'whatsapp' => ['icon' => '💬', 'uri' => 'whatsapp', 'title' => 'WhatsApp', 'admin' => true],
		'message'  => ['icon' => '🔔', 'uri' => 'messages', 'title' => 'Notifications', 'admin' => false],
		'subscription' => ['icon' => '📡', 'uri' => 'subscriptions', 'title' => 'Subscriptions', 'admin' => true],
		'user'     => ['icon' => '👤', 'uri' => 'users',    'title' => 'Users', 'admin' => true],
	]
	$out = []
	foreach ($full AS $key => $item){
		if (!phlo_exists($key)) continue
		if (($item['admin'] ?? false) && !$u->isAdmin) continue
		if (!$u->canModule($key)) continue
		$out[$key] = $item
	}
	return $out
}

# Adaptive: full mode (auth module loaded) does security/auth-gate/CMS; headless does only routing → JSON 404.
if (phlo_exists('auth')){
	%security->basic
	$this->token
	if (auth::check()) return
	auth::authed() && auth::user()
	if (trim((string)%req->path, '/') === '') return auth::home()
	if (!auth::allows(%req->path)) return main('No access to this page.', 'No access')
}
if (app::route()) return
if (phlo_exists('auth')){
	if (%req->method !== 'GET') return apply(error: 'Invalid request')
	return main('Page not found!')
}
%res->type = 'application/json'
%res->body = json_encode(['error' => 'not found'], JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES)
return %res->render(404)

view head: %CSRF

<style>
:root {
	font-family: system-ui, Segoe UI, Roboto, Helvetica, Arial, sans-serif
	scroll-behavior: smooth
}
dialog p: white-space: pre-wrap
</style>
