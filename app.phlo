static %model.DB => getenv('PHLO_TEST_DB') === 'sqlite' ? %SQLite(data.'test.db') : %MySQL
prop lang => defined('lang') ? lang : 'en'
prop title = 'Phlo Dashboard'
prop themeColor = 'black'
prop theme => %session->theme ?? 'ionstorm'
prop trans => %session->trans ?? 'ripple'
prop version = '1.0'
prop %AI.model = 'gpt-4o-mini'
prop publicPaths = ['api/feed', 'api/visitors', 'api/auth', 'api/manage', 'api/notify', 'api/wa/']
prop logout = '/logout'
prop tasks => arr(poll: arr(do: 'fleet::poll', every: '2 minutes'))

prop models => array_values(array_filter(['visitor', 'domain', 'user', 'subscription'], fn($m) => phlo_exists($m)))
prop menu {
	$u = auth::user()
	if (!$u) return []
	$full = [
		'visitor'  => ['icon' => '👁️', 'uri' => 'visitors', 'title' => 'Visitors', 'admin' => true],
		'dbadmin'  => ['icon' => '🛢️', 'uri' => 'dbadmin',  'title' => 'Database', 'admin' => true],
		'overview' => ['icon' => '🏠', 'uri' => 'overview', 'title' => 'Overview', 'admin' => false],
		'graph'    => ['icon' => '🕸️', 'uri' => 'graph', 'title' => 'Graph', 'admin' => false],
		'domain'   => ['icon' => '🌍', 'uri' => 'domains',  'title' => 'Domains', 'admin' => true],
		'site'     => ['icon' => '🌐', 'uri' => 'sites',    'title' => 'Sites', 'admin' => true],
		'product'  => ['icon' => '📦', 'uri' => 'products', 'title' => 'Products', 'admin' => false],
		'whatsapp' => ['icon' => '💬', 'uri' => 'whatsapp', 'title' => 'WhatsApp', 'admin' => true],
		'message'  => ['icon' => '🔔', 'uri' => 'messages', 'title' => 'Notifications', 'admin' => false],
		'subscription' => ['icon' => '📡', 'uri' => 'subscriptions', 'title' => 'Subscriptions', 'admin' => true],
		'user'     => ['icon' => '👤', 'uri' => 'users',    'title' => 'Users', 'admin' => true],
		'backup'   => ['icon' => '💾', 'uri' => 'backups', 'title' => 'Backups', 'admin' => true],
	]
	$out = []
	foreach ($full AS $key => $item){
		if (!phlo_exists($key)) continue
		if (($item['admin'] ?? false) && !$u->isAdmin) continue
		if (!$u->canModule($key)) continue
		$out[$key] = $item
	}
	return $out
}

// Guarded en() so the CMS chrome renders without lang.phlo; a loaded lang.phlo defines en() first and wins.
if (!function_exists('en')){function en($t, ...$a){return $a ? sprintf($t, ...$a) : $t;}}

// Adaptive: full mode (auth module loaded) does security/auth-gate/CMS; headless does only routing → JSON 404.
if (phlo_exists('auth')){
	%security->basic
	if (auth::check()) return
	auth::authed() && auth::user()
	if (trim((string)%req->path, '/') === '') return auth::home()
	// A refusal is not a success: the page renders as before, but with the status that says
	// what happened. Async requests carry no status (apply() always renders 200), so there
	// the message in the body is the answer.
	if (!auth::allows(%req->path)) return main('No access to this page.', 'No access', code: 403)
}
%cookies->token ??= token(20)
if (app::route()) return

// Nothing answered this request. app::route() is a plain bool: false covers both "no route
// matched" and "a route matched and declined" (its callback returned false, the way a page
// says the record it was asked for does not exist). Either way nothing was produced, so the
// answer is the same and it is a 404. Answering 200 with a page that says "not found" leaves
// a monitor, a crawler, a healthcheck and a client script unable to tell a missing page from
// a working one.

// Headless (no auth module): a routing-only node that speaks JSON, never pages.
if (!phlo_exists('auth')) return output(['error' => 'not found'], code: 404)

// A write from the app itself that lands nowhere: the client expects commands back, not a
// page swap, so it keeps its form and gets the message as a notice.
if (%req->async && !in_array(%req->method, ['GET', 'HEAD'], true)) return apply(error: 'Page not found')

// HEAD is a GET without a body and route() treats it as one; only this fallback did not, so
// every HEAD to an unknown path answered "Invalid request" in JSON with a 200.
return main('Page not found!', 'Page not found', code: 404)

view head: %CSRF
