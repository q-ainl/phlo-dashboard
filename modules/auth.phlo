static publicPaths => array_merge(['login', 'logout', 'fleet'], (array)(%app->publicPaths ?? []))

static authed => (bool)(%session->user ?? null)

static publicPath($path = null) => in_array(explode('/', trim((string)($path ?? %req->path), '/'))[0], static::publicPaths())

static siteCreds => parse_ini_file(data.'auth.ini', true, INI_SCANNER_RAW)['site'] ?? []

static verifyIni($user, $pass){
	$c = static::siteCreds()
	$u = (string)($c['user'] ?? void)
	$p = (string)($c['password'] ?? void)
	return $u !== void && $p !== void && hash_equals($u, (string)$user) && hash_equals($p, (string)$pass)
}

static user {
	%req->authUser ??= ((%session->user ?? null) === 'root') ? new user(id: 'root', name: 'root', email: 'root', role: 'admin', active: 1) : (user::authUser() ?: false)
	return %req->authUser ?: null
}

static moduleFor($path){
	$seg = explode('/', trim((string)$path, '/'))[0] ?? void
	return ['users' => 'user', 'visitors' => 'visitor', 'domains' => 'domain', 'sites' => 'site', 'whatsapp' => 'whatsapp', 'overview' => 'overview', 'node' => 'overview', 'errors' => 'overview', 'messages' => 'message', 'subscriptions' => 'subscription'][$seg] ?? null
}

static allows($path){
	$mod = static::moduleFor($path)
	if (!$mod) return true
	$u = static::user()
	if (!$u) return false
	if (in_array($mod, ['user', 'visitor', 'domain', 'site', 'whatsapp', 'subscription']) && !$u->isAdmin) return false
	return $u->canModule($mod)
}

static servers {
	$u = static::user()
	return $u ? array_values(array_filter(fleet::nodes(), fn($n) => $u->canServer($n))) : []
}

static themeCss {
	$css = []
	%app->theme && $css[] = '/theme.'.%app->theme.'.css'
	%app->trans && $css[] = '/trans.'.%app->trans.'.css'
	return $css
}

static home {
	%app->active = 'dashboard'
	return view(phlo('CMS_layout').lf.tag('main', indentView(lf.phlo('CMS_dashboard')->view.lf)), path: void)
}

static check {
	if (static::publicPath()) return false
	if (static::authed() && static::user()) return false
	unset(%session->user)
	unset(%session->name)
	return view(phlo('auth')->loginPage, 'Inloggen', css: static::themeCss())
}

static logout {
	unset(%session->user)
	unset(%session->name)
	return view(phlo('auth')->loginPage, 'Inloggen', css: static::themeCss())
}

route both GET login {
	if (static::authed() && %req->async) return static::home()
	return view($this->loginPage, 'Inloggen', css: static::themeCss())
}

route async POST login {
	$email = trim((string)(%payload->email ?? %payload->username ?? void))
	$pass = trim((string)(%payload->password ?? void))
	if (!$email || !$pass) return apply(inner: ['#loginError' => tag('span', 'Vul e-mailadres en wachtwoord in', class: 'login-err')])
	if ($u = user::verify($email, $pass)){
		%session->user = $u->id
		%session->name = $u->displayName
		return static::home()
	}
	if (static::verifyIni($email, $pass)){
		%session->user = 'root'
		%session->name = 'root'
		return static::home()
	}
	return apply(inner: ['#loginError' => tag('span', 'Onbekende combinatie van e-mailadres en wachtwoord', class: 'login-err')])
}

route both GET logout => auth::logout()

view loginPage:
<div.login-page>
	<form.async.login-box method=post action="/login">
		<h1.login-title>Dashboard</h1>
		<p.login-sub>Log in om door te gaan</p>
		<label.login-field>
			<span>E-mail of gebruikersnaam</span>
			<input name=email type=text autocomplete=username required autofocus>
		</label>
		<label.login-field>
			<span>Wachtwoord</span>
			<input name=password type=password autocomplete=current-password required>
		</label>
		<div#loginError></div>
		<button.login-btn type=submit>Inloggen</button>
	</form>
</div>

<style>
body:has(.login-page) {
	background: $bg
	color: $text
	margin: 0
}
.login-page {
	align-items: center
	display: flex
	justify-content: center
	min-height: 100dvh
	padding: 1rem
}
.login-box {
	background: $surface
	border: 1px solid $border
	border-radius: 14px
	box-shadow: 0 10px 30px #0007
	display: flex
	flex-direction: column
	gap: .9rem
	max-width: 360px
	padding: 2rem
	width: 100%
}
.login-title {
	color: $text
	font-size: 1.5rem
	font-weight: 800
	margin: 0
}
.login-sub {
	color: $muted
	margin: 0 0 .5rem
}
.login-field {
	display: flex
	flex-direction: column
	gap: .3rem
}
.login-field span {
	color: $muted
	font-size: .8rem
}
.login-field input {
	background: $bg
	border: 1px solid $border
	border-radius: 8px
	color: $text
	font-size: 1rem
	padding: .6rem .75rem
}
.login-field input:focus {
	border-color: $primary
	outline: none
}
.login-btn {
	background: $primary
	border: none
	border-radius: 8px
	color: $on-primary
	cursor: pointer
	font-size: 1rem
	font-weight: 700
	margin-top: .5rem
	padding: .7rem
}
.login-btn:hover: opacity: .9
.login-err {
	color: $error
	display: block
	font-size: .85rem
}
</style>
