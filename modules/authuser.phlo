# Minimal auth-user representation for the [site]/root login (no DB model).
# This makes the 'user' module (DB multi-user + /users management UI) optional: a leaf node
# loads only this class for auth, without a Users nav/route. Full nodes also load 'user'.
prop id = 'root'
prop name = 'root'
prop email = 'root'
prop role = 'admin'
prop active = 1
prop isAdmin => $this->role === 'admin'
prop displayName => $this->name

method canServer($node) => $this->role === 'admin'
method canModule($module) => $this->role === 'admin'
