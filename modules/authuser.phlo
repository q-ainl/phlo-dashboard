// Minimal auth-user for the [site]/root login (no DB model), so the 'user' module stays optional.
prop id = 'root'
prop name = 'root'
prop email = 'root'
prop role = 'admin'
prop modules = []
prop active = 1
prop isAdmin => $this->role === 'admin'
prop displayName => $this->name

method canServer($node) => $this->isAdmin
method canModule($module) => $this->isAdmin || in_array($module, (array)$this->modules, true)
