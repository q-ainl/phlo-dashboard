static card($label, $b, $open = false){
	$when = substr((string)$b['ts'], 0, 16)
	$sum = esc($label).': '.en('ran %s - %d files copied', $when, (int)$b['copied']).((int)$b['removed'] ? en(', %d deleted', (int)$b['removed']) : '')
	$dump = void
	foreach ($b['files'] ?? [] AS $f) $dump .= esc($f).lf
	if ((int)$b['copied'] > count($b['files'] ?? [])) $dump .= en('... and %d more', (int)$b['copied'] - count($b['files'])).lf
	foreach ($b['gone'] ?? [] AS $f) $dump .= en('[deleted]').' '.esc($f).lf
	return tag('details', tag('summary', $sum, class: 'bk-sum').tag('pre', $dump ?: en('no files changed'), class: 'bk-log'), class: 'bk-item', open: $open ? true : null)
}

static view {
	$nodes = []
	foreach (fleet::nodes() AS $node){
		$feed = fleet::cached($node)
		$b = $feed['backups'] ?? null
		if (!is_array($b) || !isset($b['ts'])) continue
		$nodes[] = ['label' => $feed['label'] ?? $node, 'b' => $b]
	}
	if (!$nodes) return tag('div', tag('p', en('No backup data reported yet.'), class: 'bk-empty'), class: 'bk-list')
	$open = count($nodes) === 1
	$items = void
	foreach ($nodes AS $n) $items .= static::card($n['label'], $n['b'], $open)
	return tag('div', $items, class: 'bk-list')
}

route both GET backups {
	if (!auth::user()?->isAdmin) return main(en('No access to this page.'), en('No access'))
	%app->active = 'backup'
	main(static::view(), en('Backups'))
}

<style>
.bk-list {
	display: flex
	flex-direction: column
	gap: 10px
}
.bk-item {
	background: $bg
	border: 1px solid $border
	border-radius: 8px
	overflow: hidden
}
.bk-sum {
	cursor: pointer
	padding: 12px 16px
	color: $text
	font-weight: 600
	list-style: none
}
.bk-sum::-webkit-details-marker {
	display: none
}
.bk-sum::before {
	content: "\25B8"
	color: $muted
	margin-right: 8px
}
.bk-item[open] .bk-sum::before {
	content: "\25BE"
}
.bk-log {
	margin: 0
	padding: 12px 16px
	border-top: 1px solid $border
	max-height: 60vh
	overflow: auto
	font: 12px/1.6 ui-monospace, "SF Mono", Menlo, monospace
	color: $muted
	white-space: pre-wrap
	word-break: break-all
}
.bk-empty {
	color: $muted
	padding: 16px
}
</style>
