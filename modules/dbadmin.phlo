}

route async POST dbadmin column $db $table {
	if ($g = static::gate()) return $g
	$p = %payload->objData
	$name = trim((string)($p['c0_name'] ?? void))
	if ($name === void) return apply(error: 'Enter a column name')
	try {
		static::checkTable($db, $table)
		$def = static::columnDef($name, $p['c0_type'] ?? 'INT', $p['c0_len'] ?? void, isset($p['c0_null']), $p['c0_default'] ?? void, isset($p['c0_auto']))
		$orig = trim((string)($p['orig'] ?? void))
		if ($orig !== void) static::q('ALTER TABLE '.static::rel($db, $table).' CHANGE '.static::ident($orig).space.$def)
		else static::q('ALTER TABLE '.static::rel($db, $table).' ADD '.$def)
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(toast: '✓ Column saved', location: static::href('structure', $db, $table))
}

route both GET dbadmin status {
