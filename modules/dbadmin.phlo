		static::checkTable($db, $table)
		static::q((static::isSqlite() ? 'DELETE FROM ' : 'TRUNCATE TABLE ').static::rel($db, $table))
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(toast: '✓ Table emptied', location: static::href('table', $db, $table))
}

route async POST dbadmin rename $db $table {
	if ($g = static::gate()) return $g
