route both GET dbadmin alter $db $table {
	return static::page(fn() => static::structureEditView($db, $table), $table.' · edit structure')
}

# Reads columns in DOM order (payload order) so reordering counts.
static alterPlan($p, $current){
	$order = []
	foreach (array_keys($p) AS $k){
		$m = regex('/^c(\w+)_name$/', $k)
		$m && trim((string)$p[$k]) !== void && $order[] = $m[1]
	}
	$cols = []
	foreach ($order AS $i){
		$cols[] = ['i' => $i, 'name' => trim((string)$p['c'.$i.'_name']), 'orig' => trim((string)($p['c'.$i.'_orig'] ?? void)), 'pk' => isset($p['c'.$i.'_pk']), 'auto' => isset($p['c'.$i.'_auto'])]
	}
	return $cols
}

route async POST dbadmin alter $db $table {
	if ($g = static::gate()) return $g
	$p = %payload->objData
	try {
		static::checkTable($db, $table)
		$current = array_column(static::columns($db, $table), null, 'Field')
		$cols = static::alterPlan($p, $current)
		if (!$cols) return apply(error: 'No columns received')
		$def = fn($c) => static::columnDef($c['name'], $p['c'.$c['i'].'_type'] ?? 'INT', $p['c'.$c['i'].'_len'] ?? void, isset($p['c'.$c['i'].'_null']), $p['c'.$c['i'].'_default'] ?? void, $c['auto'])
		if (static::isSqlite()){
			$pks = array_values(array_filter(array_map(fn($c) => $c['pk'] ? $c['name'] : null, $cols)))
			$defs = []
			foreach ($cols AS $c){
				$d = $def($c)
				count($pks) === 1 && $c['pk'] && $d .= ' PRIMARY KEY'.($c['auto'] && strcasecmp(static::colType($p['c'.$c['i'].'_type'] ?? void), 'INTEGER') === 0 ? ' AUTOINCREMENT' : void)
				$defs[] = $d
			}
			count($pks) > 1 && $defs[] = 'PRIMARY KEY ('.loop($pks, fn($n) => static::ident($n), comma).')'
			$tmp = $table.'_phlo_tmp'
			$pairs = array_filter($cols, fn($c) => $c['orig'] !== void && isset($current[$c['orig']]))
			$pdo = static::dbh()
			$pdo->beginTransaction()
			try {
				$pdo->exec('CREATE TABLE '.static::ident($tmp).' ('.implode(', ', $defs).')')
				if ($pairs) $pdo->exec('INSERT INTO '.static::ident($tmp).' ('.loop($pairs, fn($c) => static::ident($c['name']), comma).') SELECT '.loop($pairs, fn($c) => static::ident($c['orig']), comma).' FROM '.static::ident($table))
				$pdo->exec('DROP TABLE '.static::ident($table))
				$pdo->exec('ALTER TABLE '.static::ident($tmp).' RENAME TO '.static::ident($table))
				$pdo->commit()
			}
			catch (\PDOException $e){
				$pdo->inTransaction() && $pdo->rollBack()
				return apply(error: $e->getMessage())
			}
		}
		else {
			$ops = []
			$prev = null
			$kept = []
			foreach ($cols AS $c){
				$pos = is_null($prev) ? ' FIRST' : ' AFTER '.static::ident($prev)
				if ($c['orig'] !== void && isset($current[$c['orig']])){
					$ops[] = 'CHANGE '.static::ident($c['orig']).space.$def($c).$pos
					$kept[$c['orig']] = true
				}
				else $ops[] = 'ADD '.$def($c).$pos
				$prev = $c['name']
			}
			foreach (array_keys($current) AS $orig) if (!isset($kept[$orig])) $ops[] = 'DROP COLUMN '.static::ident($orig)
			static::q('ALTER TABLE '.static::rel($db, $table).' '.implode(', ', $ops))
		}
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(toast: '✓ Structure saved', location: static::href('structure', $db, $table))
}

route async POST dbadmin dropcolumn $db $table {
	if ($g = static::gate()) return $g
	$col = trim((string)(%payload->col ?? void))
	try {
		static::checkTable($db, $table)
		static::q('ALTER TABLE '.static::rel($db, $table).' DROP COLUMN '.static::ident($col))
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(toast: '✓ Column deleted', location: static::href('structure', $db, $table))
}

route async POST dbadmin index $db $table {
	if ($g = static::gate()) return $g
	$type = strtoupper(trim((string)(%payload->type ?? 'INDEX')))
	in_array($type, ['INDEX', 'UNIQUE', 'FULLTEXT', 'PRIMARY']) || $type = 'INDEX'
	$name = trim((string)(%payload->name ?? void))
	$want = array_filter(array_map('trim', explode(',', (string)(%payload->cols ?? void))))
	if (!$want) return apply(error: 'Specify at least one column')
	try {
		$real = array_column(static::columns($db, $table), 'Field')
		foreach ($want AS $w) in_array($w, $real) || error('Unknown column: '.$w, 400)
		$colSql = loop($want, fn($c) => static::ident($c), comma)
		if (static::isSqlite()){
			$type === 'PRIMARY' && error('SQLite: PRIMARY KEY cannot be added as a separate index', 400)
			$iname = $name !== void ? $name : 'idx_'.$table.'_'.implode('_', $want)
			static::q('CREATE '.($type === 'UNIQUE' ? 'UNIQUE ' : void).'INDEX '.static::ident($iname).' ON '.static::ident($table).' ('.$colSql.')')
		}
		else {
			$named = $name !== void ? space.static::ident($name) : void
			$add = $type === 'PRIMARY' ? 'ADD PRIMARY KEY ('.$colSql.')' : 'ADD '.($type === 'INDEX' ? 'INDEX' : $type).$named.' ('.$colSql.')'
			static::q('ALTER TABLE '.static::rel($db, $table).' '.$add)
		}
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(toast: '✓ Index added', location: static::href('structure', $db, $table))
}

route async POST dbadmin dropindex $db $table {
	if ($g = static::gate()) return $g
	$name = trim((string)(%payload->name ?? void))
	try {
		static::checkTable($db, $table)
		if (static::isSqlite()){
			strtoupper($name) === 'PRIMARY' && error('SQLite: PRIMARY KEY cannot be dropped separately', 400)
			static::q('DROP INDEX '.static::ident($name))
		}
		else {
			$sql = strtoupper($name) === 'PRIMARY' ? 'DROP PRIMARY KEY' : 'DROP INDEX '.static::ident($name)
			static::q('ALTER TABLE '.static::rel($db, $table).' '.$sql)
		}
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(toast: '✓ Index deleted', location: static::href('structure', $db, $table))
}

route async POST dbadmin fk $db $table {
	if ($g = static::gate()) return $g
	$p = %payload->objData
	$col = trim((string)($p['col'] ?? void))
	$rdb = trim((string)($p['rdb'] ?? void))
	$rtable = trim((string)($p['rtable'] ?? void))
	$rcol = trim((string)($p['rcol'] ?? void))
	$onDelete = static::fkActions()[strtoupper(trim((string)($p['ondelete'] ?? void)))] ?? 'RESTRICT'
	$onUpdate = static::fkActions()[strtoupper(trim((string)($p['onupdate'] ?? void)))] ?? 'RESTRICT'
	if ($col === void || $rtable === void || $rcol === void) return apply(error: 'Fill in column, ref. table and ref. column')
	try {
		$real = array_column(static::columns($db, $table), 'Field')
		in_array($col, $real) || error('Unknown column: '.$col, 400)
		$sql = 'ALTER TABLE '.static::rel($db, $table).' ADD FOREIGN KEY ('.static::ident($col).') REFERENCES '.static::rel($rdb, $rtable).' ('.static::ident($rcol).') ON DELETE '.$onDelete.' ON UPDATE '.$onUpdate
		static::q($sql)
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(toast: '✓ Foreign key added', location: static::href('structure', $db, $table))
}

route async POST dbadmin dropfk $db $table {
	if ($g = static::gate()) return $g
	$name = trim((string)(%payload->name ?? void))
	try {
		static::checkTable($db, $table)
		static::q('ALTER TABLE '.static::rel($db, $table).' DROP FOREIGN KEY '.static::ident($name))
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(toast: '✓ Foreign key deleted', location: static::href('structure', $db, $table))
}

route async POST dbadmin import $db {
	if ($g = static::gate()) return $g
	$file = %payload->sqlfile ?? null
	if (!is_object($file)) return apply(inner: ['#importResult' => static::errorBox('No file received')])
	$sql = (string)$file->contents
	if (trim($sql) === void) return apply(inner: ['#importResult' => static::errorBox('Empty file')])
	$stmts = static::splitSql($sql)
	if (!$stmts) return apply(inner: ['#importResult' => static::errorBox('No executable statements found')])
	$pdo = static::dbh()
	try {
		!static::isSqlite() && $pdo->exec('USE '.static::ident($db))
	}
	catch (\PDOException $e){
		return apply(inner: ['#importResult' => static::errorBox($e->getMessage())])
	}
	$done = 0
	$pdo->beginTransaction()
	try {
		foreach ($stmts AS $st){
			$pdo->exec($st)
			$done++
		}
		$pdo->inTransaction() && $pdo->commit()
	}
	catch (\PDOException $e){
		$pdo->inTransaction() && $pdo->rollBack()
		return apply(inner: ['#importResult' => static::errorBox('Statement '.($done + 1).' of '.count($stmts).' failed: '.$e->getMessage())])
	}
	return apply(toast: '✓ '.$done.' statements executed', location: static::href('db', $db))
}

route async POST dbadmin createdatabase {
	if ($g = static::gate()) return $g
	$name = trim((string)(%payload->name ?? void))
	if ($name === void) return apply(error: 'Enter a database name')
