route async POST dbadmin row $db $table {
	if ($g = static::gate()) return $g
	try {
		static::checkTable($db, $table)
		$cols = static::columns($db, $table)
		$pk = static::pk($db, $table)
		$p = %payload->objData
		$keys = []
		foreach ($pk AS $k) isset($p['pk_'.$k]) && $keys[$k] = (string)$p['pk_'.$k]
		$editing = $pk && count($keys) === count($pk)
		$set = []
		foreach ($cols AS $c){
			$f = (string)$c['Field']
			if (!array_key_exists('val_'.$f, $p) && !isset($p['null_'.$f])) continue
			if (isset($p['null_'.$f])) $set[$f] = null
			else {
				$v = (string)($p['val_'.$f] ?? void)
				if ($v === void && str_contains((string)($c['Extra'] ?? void), 'auto_increment')) continue
				$set[$f] = $v
			}
		}
		if (!$set) return apply(error: 'No fields received')
		if ($editing) static::q('UPDATE '.static::rel($db, $table).' SET '.loop(array_keys($set), fn($f) => static::ident($f).'=?', comma).' WHERE '.loop($pk, fn($k) => static::ident($k).'=?', ' AND ').(static::isSqlite() ? void : ' LIMIT 1'), ...array_values($set), ...array_values($keys))
		else static::q('INSERT INTO '.static::rel($db, $table).' ('.loop(array_keys($set), fn($f) => static::ident($f), comma).') VALUES ('.implode(comma, array_fill(0, count($set), qm)).')', ...array_values($set))
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(location: static::href('table', $db, $table))
}

route async POST dbadmin delete $db $table {
	if ($g = static::gate()) return $g
	try {
		static::checkTable($db, $table)
		$pk = static::pk($db, $table)
		if (!$pk) return apply(error: 'Table has no primary key')
		parse_str((string)(%payload->key ?? void), $key)
		$keys = []
		foreach ($pk AS $k){
			if (!isset($key[$k])) return apply(error: 'Incomplete key')
			$keys[$k] = (string)$key[$k]
		}
		static::q('DELETE FROM '.static::rel($db, $table).' WHERE '.loop($pk, fn($k) => static::ident($k).'=?', ' AND ').(static::isSqlite() ? void : ' LIMIT 1'), ...array_values($keys))
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(location: static::href('table', $db, $table))
}

route both GET dbadmin sql $db= {
	return static::page(fn() => static::sqlView($db ?: null), 'SQL-console', null, true)
}

route async POST dbadmin sql {
	if ($g = static::gate()) return $g
	$sql = trim((string)(%payload->query ?? void))
	$db = trim((string)(%payload->db ?? void))
	if ($sql === void) return apply(inner: ['#sqlResult' => static::errorBox('No query provided')])
	$t0 = microtime(true)
	try {
		$pdo = static::dbh()
		!static::isSqlite() && $db !== void && $pdo->exec('USE '.static::ident($db))
		$stmt = $pdo->query($sql)
	}
	catch (\PDOException $e){
		return apply(inner: ['#sqlResult' => static::errorBox($e->getMessage())])
	}
	$ms = round((microtime(true) - $t0) * 1000, 1)
	if (!$stmt->columnCount()) return apply(inner: ['#sqlResult' => tag('p', '✓ '.$stmt->rowCount().' rows affected · '.$ms.'ms', class: 'db-meta ok')])
	$rows = []
	$capped = false
	foreach ($stmt AS $r){
		if (count($rows) >= 500){
			$capped = true
			break
		}
		$rows[] = $r
	}
	$out = void
	if ($rows){
		$ths = void
		foreach (array_keys($rows[0]) AS $f) $ths .= tag('th', esc((string)$f))
		$body = void
		foreach ($rows AS $r){
			$cells = void
			foreach ($r AS $v) $cells .= tag('td', static::cell($v))
			$body .= tag('tr', $cells)
		}
		$out = static::tableWrap(tag('table', tag('thead', tag('tr', $ths)).tag('tbody', $body), class: 'db-table'))
	}
	$meta = tag('p', count($rows).' rows'.($capped ? ' (capped at 500)' : void).' · '.$ms.'ms', class: 'db-meta')
	return apply(inner: ['#sqlResult' => $meta.$out])
}

