	try {
		static::checkTable($db, $table)
		static::q(static::isSqlite() ? 'ALTER TABLE '.static::rel($db, $table).' RENAME TO '.static::ident($new) : 'RENAME TABLE '.static::rel($db, $table).' TO '.static::rel($db, $new))
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
