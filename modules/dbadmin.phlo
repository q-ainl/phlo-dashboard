}

route GET dbadmin export $db $table= {
	if (!static::guard()) return main('No access to this page.', 'No access')
	if (!static::connected()) return location('/dbadmin')
	$format = strtolower((string)(%req->query['format'] ?? 'csv'))
	try {
		if (trim((string)$table) === void){
			$tables = static::tables($db)
			$totalRows = array_sum(array_map(fn($t) => (int)($t['Rows'] ?? 0), $tables))
			if ($totalRows > 500000) return main('Database too large to export. Use mysqldump.', 'Export')
			$out = '-- Phlo Dashboard export · database '.$db.' · '.date('Y-m-d H:i').lf.'SET FOREIGN_KEY_CHECKS=0;'.lf.lf
			foreach ($tables AS $t) $out .= static::dumpSql($db, (string)$t['Name']).lf
			$out .= 'SET FOREIGN_KEY_CHECKS=1;'.lf
			return output($out, $db.'.sql', true)
		}
		static::checkTable($db, $table)
		$status = null
		foreach (static::tables($db) AS $t) (string)$t['Name'] === (string)$table && $status = $t
		if ((int)($status['Rows'] ?? 0) > 250000) return main('Table too large to export. Use mysqldump.', 'Export')
		if ($format === 'sql') return output(static::dumpSql($db, $table), $db.dot.$table.'.sql', true)
		return output(static::dumpCsv($db, $table), $db.dot.$table.'.csv', true)
	}
	catch (\PDOException $e){
		return main(static::errorBox($e->getMessage()), 'Export')
	}
}

<script>
on('submit', 'form.db-search', (form, e) => {
	e.preventDefault()
	let qs = new URLSearchParams(new FormData(form)).toString()
	app.get(form.dataset.path + (qs ? '?' + qs : ''))
})
on('input', '.db-fctl input, .db-fctl textarea, .db-fctl select', (el) => {
	if (el.type === 'checkbox') return
	let box = el.closest('.db-fctl')?.querySelector('.db-null-toggle input')
	box && (box.checked = false)
})
on('click', '#dbAddCol', () => {
	let cols = obj('#dbCols'), n = cols.querySelectorAll('.db-col-row').length
	let row = obj('#dbColTpl').querySelector('.db-col-row').cloneNode(true)
	row.querySelectorAll('[name]').forEach((el) => el.name = el.name.replace('IDX', n))
	cols.appendChild(row)
})
on('input', '.db-confirm-input', (el) => {
	let btn = el.closest('form').querySelector('button[type=submit]')
	btn && (btn.disabled = el.value !== el.dataset.expect)
})
on('click', '.db-row-up', (b) => {
	let row = b.closest('.db-col-row'), prev = row.previousElementSibling
	prev && prev.classList.contains('db-col-row') && row.parentNode.insertBefore(row, prev)
})
on('click', '.db-row-down', (b) => {
	let row = b.closest('.db-col-row'), next = row.nextElementSibling
	next && next.classList.contains('db-col-row') && row.parentNode.insertBefore(next, row)
})
on('click', '.db-row-del', (b) => b.closest('.db-col-row').remove())
on('dragstart', '.db-cols-sortable .db-col-row', (row, e) => {
	phlo.dragRow = row
	row.classList.add('db-dragging')
})
on('dragend', '.db-cols-sortable .db-col-row', (row) => {
	row.classList.remove('db-dragging')
	phlo.dragRow = null
})
on('dragover', '.db-cols-sortable', (list, e) => {
	e.preventDefault()
	let drag = phlo.dragRow
	if (!drag) return
	let after = null
	list.querySelectorAll('.db-col-row:not(.db-dragging)').forEach((r) => {
		let box = r.getBoundingClientRect()
		if (e.clientY > box.top + box.height / 2) after = r
	})
	after ? after.after(drag) : list.prepend(drag)
})
</script>

<style>
.db-topbar {
	align-items: center
	background: $surface
	border: 1px solid $border
	border-radius: 10px
	display: flex
	flex-wrap: wrap
	gap: .75rem
	justify-content: space-between
	margin-bottom: 1rem
	padding: .5rem .75rem
}
.db-crumbs {
	align-items: center
	display: flex
	flex-wrap: wrap
	gap: .35rem
}
.db-crumbs a {
	color: $primary
	text-decoration: none
}
.db-crumbs span: color: $muted
.db-conn {
	align-items: center
	display: flex
	gap: .6rem
}
.db-who {
	color: $muted
	font-family: monospace
	font-size: .8rem
}
.db-scroll: overflow-x: auto
.db-table {
	background: $surface
	border: 1px solid $border
	border-collapse: collapse
	font-size: .85rem
	width: 100%
}
.db-table th {
	background: $bg
	color: $muted
	font-weight: 600
	padding: .45rem .6rem
	text-align: left
	white-space: nowrap
}
.db-table th a {
	color: $muted
	text-decoration: none
	\:hover: color: $primary
}
.db-table td {
	border-top: 1px solid $border
	max-width: 28rem
	overflow-wrap: break-word
	padding: .4rem .6rem
	vertical-align: top
}
.db-table td.muted: color: $muted
.db-table .num: text-align: right
.db-table tr {
	\:hover td: background: color-mix(in srgb, $surface 88%, $primary)
}
.db-name {
	color: $primary
	font-weight: 600
	text-decoration: none
}
.db-fk-link {
	color: $primary
	text-decoration: none
}
.db-fk-link:hover: text-decoration: underline
.db-btn {
	align-items: center
	background: $bg
	border: 1px solid $border
	border-radius: 8px
	color: $text
	cursor: pointer
	display: inline-flex
	font-size: .85rem
	gap: .3rem
	padding: .35rem .7rem
	text-decoration: none
}
.db-btn:hover: border-color: $primary
.db-btn.primary {
	background: $primary
	border-color: $primary
	color: $on-primary
}
.db-btn.ghost: background: transparent
.db-btn.mini {
	font-size: .72rem
	padding: .15rem .45rem
}
.db-bar {
	align-items: center
	display: flex
	flex-wrap: wrap
	gap: .5rem
	margin: 0 0 .8rem
}
.db-bar.end: justify-content: flex-end
.db-search {
	align-items: center
	display: inline-flex
	gap: .4rem
	margin-left: auto
}
.db-search input {
	background: $bg
	border: 1px solid $border
	border-radius: 8px
	color: $text
	padding: .35rem .6rem
}
.db-acts {
	text-align: right
	white-space: nowrap
}
.db-acts a, .db-acts button: margin-left: .3rem
.db-act {
	background: none
	border: none
	cursor: pointer
	font-size: .9rem
	padding: .1rem .25rem
	text-decoration: none
}
.db-null {
	color: $muted
	font-style: italic
	opacity: .7
}
.db-errorbox {
	background: color-mix(in srgb, $error 12%, $surface)
	border: 1px solid $error
	border-radius: 10px
	margin: .8rem 0
	padding: .7rem 1rem
	white-space: pre-wrap
}
.db-note {
	color: $muted
	font-size: .85rem
}
.db-meta {
	color: $muted
	font-family: monospace
	font-size: .85rem
	margin: .6rem 0
}
.db-meta.ok: color: $success
.db-pager {
	align-items: center
	display: flex
	gap: .6rem
	margin-top: .8rem
}
.db-pageinfo: color: $muted
.db-login {
	background: $surface
	border: 1px solid $border
	border-radius: 14px
	display: flex
	flex-direction: column
	gap: .9rem
	max-width: 360px
	padding: 1.5rem
}
.db-field {
	display: flex
	flex-direction: column
	gap: .3rem
}
.db-field span {
	color: $muted
	font-size: .8rem
}
.db-field input {
	background: $bg
	border: 1px solid $border
	border-radius: 8px
	color: $text
	padding: .55rem .7rem
}
.db-err {
	color: $error
	display: block
