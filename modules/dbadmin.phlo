route async POST dbadmin privilege create {
	if ($g = static::gate()) return $g
	$user = trim((string)(%payload->user ?? void))
	$host = trim((string)(%payload->host ?? void)) ?: '%'
	$pass = (string)(%payload->password ?? void)
	if ($user === void) return apply(error: 'Enter a username')
	try {
		static::checkHost($host)
		static::q('CREATE USER '.static::acct($user, $host).($pass !== void ? ' IDENTIFIED BY '.%dbadmin->PDO->quote($pass) : void))
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(location: static::accountUrl($user, $host))
}

route async POST dbadmin privilege grant {
	if ($g = static::gate()) return $g
	$p = %payload->objData
	$user = (string)($p['user'] ?? void)
	$host = (string)($p['host'] ?? '%')
	$privs = []
	foreach (static::privs() AS $key => $label) isset($p['priv_'.$key]) && $privs[] = $label
	if (!$privs) return apply(error: 'Select at least one privilege')
	$db = (string)($p['db'] ?? '*')
	$table = trim((string)($p['table'] ?? void)) ?: '*'
	try {
		$scope = $db === '*' ? '*.*' : static::ident($db).dot.($table === '*' ? '*' : static::ident($table))
		static::q('GRANT '.implode(', ', $privs).' ON '.$scope.' TO '.static::acct($user, $host).(isset($p['grantopt']) ? ' WITH GRANT OPTION' : void))
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(location: static::accountUrl($user, $host))
}

route async POST dbadmin privilege revoke {
	if ($g = static::gate()) return $g
	$user = (string)(%payload->u ?? void)
	$host = (string)(%payload->h ?? void)
	$hash = (string)(%payload->g ?? void)
	try {
		$line = null
		foreach (static::grants($user, $host) AS $g) sha1((string)$g) === $hash && $line = (string)$g
		if (is_null($line)) return apply(error: 'Privilege not found. The page may be outdated, reload')
		$m = regex('/^GRANT (.+) ON (.+?) TO /i', $line)
		if (!$m) return apply(error: 'This privilege cannot be revoked')
		$privList = $m[1].(stripos($line, 'WITH GRANT OPTION') !== false ? ', GRANT OPTION' : void)
		static::q('REVOKE '.$privList.' ON '.$m[2].' FROM '.static::acct($user, $host))
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(location: static::accountUrl($user, $host))
}

route async POST dbadmin privilege password {
	if ($g = static::gate()) return $g
	$user = (string)(%payload->user ?? void)
	$host = (string)(%payload->host ?? '%')
	$pass = (string)(%payload->password ?? void)
	if ($pass === void) return apply(error: 'Enter a password')
	try {
		static::q('ALTER USER '.static::acct($user, $host).' IDENTIFIED BY '.%dbadmin->PDO->quote($pass))
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(toast: '✓ Password changed', location: static::accountUrl($user, $host))
}

route async POST dbadmin privilege drop {
	if ($g = static::gate()) return $g
	$user = (string)(%payload->u ?? void)
	$host = (string)(%payload->h ?? void)
	try {
		static::q('DROP USER '.static::acct($user, $host))
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(location: '/dbadmin/privileges')
}

route both GET dbadmin create $db {
	return static::page(fn() => static::createTableView($db), 'New table')
}

route async POST dbadmin create $db {
	if ($g = static::gate()) return $g
	$p = %payload->objData
	$table = trim((string)($p['table'] ?? void))
	if ($table === void) return apply(error: 'Enter a table name')
	try {
		static::ident($table)
		$cols = static::columnsFromPayload($p)
		if (!$cols['defs']) return apply(error: 'Add at least one column')
		$defs = $cols['defs']
		$cols['pks'] && $defs[] = 'PRIMARY KEY ('.implode(comma, $cols['pks']).')'
		static::q('CREATE TABLE '.static::rel($db, $table).' ('.implode(', ', $defs).')')
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(toast: '✓ Table created', location: static::href('structure', $db, $table))
}

route async POST dbadmin drop $db $table {
	if ($g = static::gate()) return $g
	if ((string)(%payload->confirm ?? void) !== (string)$table) return apply(error: 'Type the table name exactly to confirm')
	try {
		static::checkTable($db, $table)
		static::q('DROP TABLE '.static::rel($db, $table))
	}
	catch (\PDOException $e){
		return apply(error: $e->getMessage())
	}
	return apply(toast: '✓ Table deleted', location: static::href('db', $db))
}

route async POST dbadmin truncate $db $table {
