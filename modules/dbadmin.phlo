route async POST dbadmin login {
	if ($g = static::gate(false)) return $g
	$c = ['driver' => 'mysql', 'host' => trim((string)(%payload->host ?? void)) ?: 'localhost', 'user' => trim((string)(%payload->user ?? void)), 'pass' => (string)(%payload->password ?? void)]
	if ($c['user'] === void) return apply(inner: ['#dbLoginError' => tag('span', 'Enter a username', class: 'db-err')])
	try {
		static::connectMysql($c)
	}
	catch (\PDOException $e){
		return apply(inner: ['#dbLoginError' => tag('span', esc($e->getMessage()), class: 'db-err')])
	}
	%session->dbadmin = $c
	return location('/dbadmin')
}

route async POST dbadmin sqlite {
	if ($g = static::gate(false)) return $g
	$name = basename((string)(%payload->file ?? void))
	$files = static::dataFiles()
	if (!isset($files[$name])) return apply(inner: ['#dbLoginError' => tag('span', 'Unknown file', class: 'db-err')])
	try {
		phlo('SQLite', $files[$name])->PDO->query('SELECT 1')
	}
	catch (\Throwable $e){
		return apply(inner: ['#dbLoginError' => tag('span', esc($e->getMessage()), class: 'db-err')])
	}
	%session->dbadmin = ['driver' => 'sqlite', 'file' => $files[$name], 'name' => $name]
	return location('/dbadmin')
}

