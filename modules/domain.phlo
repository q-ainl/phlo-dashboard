@ extends: model

view: $this->id

static titleList = 'Domains'
static titleRecord = 'Domain'

static pp = 100
static table = 'domains'
static order = 'id ASC'

# Access and writes are admin-only (enforced by the CMS view/API permission hooks + the module RBAC gate).
static canView => (bool)(auth::user()?->isAdmin)
static canCreate => (bool)(auth::user()?->isAdmin)
static canChange($r = null) => (bool)(auth::user()?->isAdmin)
static canDelete($r = null) => (bool)(auth::user()?->isAdmin)

# The primary key is the domain name itself (text), not an auto-increment int (the model default).
static idType = 'string'

# Registrar options for the select. Override per node with a comma list in creds.ini ([domain] registrars = ...).
static registrars {
	$cfg = (string)(%creds->domain?->registrars ?? void)
	$list = $cfg !== void ? array_values(array_filter(loop(explode(',', $cfg), fn($s) => trim($s)), 'strlen')) : []
	return $list ?: ['External']
}

static objFilters = [
	'mail' => [
		'title'  => 'With email',
		'filter' => 'mail = 1',
	],
]

static objSorts = [
	'expires' => [
		'title' => 'Expiry date',
		'order' => 'expires ASC',
	],
]

static objWidgets => [
	'Domain expiry' => obj (
			order: 5,
			type: 'list',
			data: loop(static::records(
				table: 'domains',
				order: 'expires ASC',
				limit: 5,
			), fn($info, $domain) => tag('a', $domain, href: "https://$domain/").': '.tag('span', void, data_ts: strtotime($info->expires)),
		),
	),
]

static schema => arr (
	id: field (
		type: 'text',
		title: 'Domain',
		change: 'label',
	),
	registrar: field (
		type: 'select',
		title: 'Registrant',
		options: static::registrars(),
	),
	mail: field (
		type: 'bool',
		title: 'Email',
	),
	expires: field (
		type: 'date',
		title: 'Expires',
	),
)
