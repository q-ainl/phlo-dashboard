static peers => %creds->fleet ?? null

// Shared HMAC peer authentication. The request carries X-Fleet-Time + X-Fleet-Sign; we rebuild the signed
// payload from the timestamp via $payload($time) and compare against each peer secret. $require optionally
// limits to peers with that flag set to '1' (e.g. 'manage'). Returns the matching peer name or false.
static verifyPeer($payload, $require = null){
	$time = (int)($_SERVER['HTTP_X_FLEET_TIME'] ?? 0)
	$sign = (string)($_SERVER['HTTP_X_FLEET_SIGN'] ?? void)
	if (!$time || $sign === void || abs(time() - $time) > 300) return false
	$peers = static::peers()
	if (!$peers) return false
	foreach ($peers AS $name => $peer){
		if ($require !== null && ((string)($peer->$require ?? void)) !== '1') continue
		$secret = (string)($peer->secret ?? void)
		if ($secret === void) continue
		if (hash_equals(hash_hmac('sha256', (string)$payload($time), $secret), $sign)) return $name
	}
	return false
}

// Builds the X-Fleet-Time + X-Fleet-Sign request headers. The signed payload is the timestamp, optionally
// suffixed with '.'.$extra (mirrors the verifyPeer payloads on the receiving side).
static signHeaders($secret, $extra = ''){
	$t = (string)time()
	$payload = $extra !== '' ? $t.'.'.$extra : $t
	return ['X-Fleet-Time: '.$t, 'X-Fleet-Sign: '.hash_hmac('sha256', $payload, $secret)]
}

static localCreds {
	$ini = @parse_ini_file(static::base().'/dashboard/data/creds.ini', true, INI_SCANNER_RAW)
	return is_array($ini) ? $ini : []
}


static authPeer => static::verifyPeer(fn($t) => (string)$t)

static feedData => static::collect()

// Control base (the directory that contains this dashboard): /srv/control or /files/Server/control, derived from app.
// realpath first, so a dev entry resolving through www/.. yields the same base as the flattened prod dir
static base => dirname(realpath(rtrim(app, '/')) ?: rtrim(app, '/'))

// System Caddy sites that are infrastructure, not deployable apps: hidden from app/site listings.
// Override per node with a comma list in creds.ini ([hiddenSites] is not a section; use hiddenSites = a, b, c).
static hiddenSites {
	$cfg = (string)(%creds->hiddenSites ?? void)
	$list = $cfg !== void ? array_values(array_filter(loop(explode(',', $cfg), fn($s) => trim($s)), 'strlen')) : []
	return $list ?: ['control', 'whatsapp']
}

// OS user/group that should own files written by the runtime (best-effort chown). Configurable per node.
static webUser => (string)(%creds->node?->webuser ?? 'frankenphp')

// Shell command that restarts the local realtime websocket server (pm2). Configurable per node.
static wsRestart => (string)(%creds->whatsapp?->restart ?? 'HOME=/var/lib/frankenphp /usr/local/bin/pm2 restart websocket 2>&1')

static env($block){
	$root = static::rootFromBlock($block)
	return $root && preg_match('/\bbuild\s*:\s*true\b/', (string)@file_get_contents($root.'/www/app.php')) ? 'dev' : 'prod'
}
static rootFromBlock($block){
	if ($r = regex('/^\s*root\s+\*?\s*(\S+)/m', $block)[1] ?? void) return static::stripWww($r)
	preg_match_all('/^[ \t]*import[ \t]+(\S+)([^\n]*)/m', $block, $ms, PREG_SET_ORDER)
	foreach ($ms AS $imp){
		if (($def = static::snippetRoot($imp[1])) === void) continue
		$args = preg_split('/\s+/', trim($imp[2]), -1, PREG_SPLIT_NO_EMPTY)
		return static::stripWww(preg_replace_callback('/\{args\[(\d+)\]\}/', fn($m) => $args[(int)$m[1]] ?? '', $def))
	}
	return void
}
static stripWww($r) => str_ends_with((string)$r, '/www') ? substr((string)$r, 0, -4) : (string)$r
static snippetRoot($name){
	foreach (array_merge([static::base().'/config/Caddyfile'], glob(static::base().'/sites/*.caddy') ?: []) AS $f){
		if (preg_match('/\('.preg_quote($name, '/').'\)\s*\{(.*?)^\}/ms', (string)@file_get_contents($f), $m) && ($r = regex('/^\s*root\s+\*?\s*(\S+)/m', $m[1])[1] ?? void)) return $r
	}
	return void
}

// Shared host normalization: primary host = shortest non-www, env from a dev./stage. prefix, the rest become
// aliases. Each discovery adapter feeds raw hostnames + which of them are redirect-only.
static normalizeApp($appName, $hostnames, $redirected, $pureRedirect, $env){
	$canonical = array_values(array_diff($hostnames, $redirected))
	if (!$canonical){
		$pureRedirect = true
		$canonical = $hostnames
	}
	$nonWww = array_values(array_filter($canonical, fn($h) => !str_starts_with($h, 'www.')))
	$candidates = $nonWww ?: $canonical
	usort($candidates, fn($a, $c) => strlen($a) <=> strlen($c) ?: strcmp($a, $c))
	$primary = $candidates[0]
	$he = $env
	$aliases = array_values(array_filter($hostnames, fn($h) => $h !== $primary))
	return ['host' => $primary, 'aliases' => $aliases, 'env' => $he, 'app' => $appName, 'redirect' => $pureRedirect]
}

// Which discovery adapters to run, per node via creds.ini [discovery] sources = caddy, nginx
// (default caddy, so existing nodes are unchanged). Each name maps to a <name>Apps() adapter.
static sources {
	$cfg = (string)(%creds->discovery?->sources ?? void)
	$list = $cfg !== void ? array_values(array_filter(loop(explode(',', $cfg), fn($s) => trim(strtolower($s))), 'strlen')) : []
	return $list ?: ['caddy']
}

static discoverApps {
	$seen = []
	$apps = []
	foreach (static::sources() AS $src){
		$rows = $src === 'nginx' ? static::nginxApps() : ($src === 'caddy' ? static::caddyApps() : [])
		foreach ($rows AS $row){
			$host = (string)($row['host'] ?? void)
			if ($host === '' || isset($seen[$host])) continue
			$seen[$host] = true
			$apps[] = $row
		}
	}
	return $apps
}

static caddyApps {
	$apps = []
	$skip = static::hiddenSites()
	foreach (glob(static::base().'/sites/*.caddy') AS $file){
		$appName = basename($file, '.caddy')
		if (in_array($appName, $skip, true)) continue
		$blocks = []
		$hosts = null
		$buf = ''
		foreach (explode(lf, (string)@file_get_contents($file)) AS $line){
			if (preg_match('/^([a-z0-9*][^{(\n]*?)\s*\{/', $line, $m)){
				if ($hosts !== null) $blocks[] = ['hosts' => $hosts, 'block' => $buf]
				$hosts = trim($m[1])
				$buf = $line.lf
			}
			elseif ($hosts !== null){
				$buf .= $line.lf
			}
		}
		if ($hosts !== null) $blocks[] = ['hosts' => $hosts, 'block' => $buf]
		foreach ($blocks AS $b){
			$env = static::env($b['block'])
			$hostnames = []
			foreach (explode(',', $b['hosts']) AS $host){
				$host = trim($host)
				if ($host === '' || !str_contains($host, '.')) continue
				$hostnames[] = $host
			}
			if (!$hostnames) continue
			// Redirect-aware: hosts redirected within the block via an @host matcher do not count
			// as canonical (so the redirect target wins over the alias that points at it). A block that
			// redirects as a whole (bare redir, no matcher) = redirect-only → flag (not a real app host).
			$redirected = []
			$pureRedirect = false
			$matchers = []
			if (preg_match_all('/@(\w+)\s+host\s+([^\n{]+)/', $b['block'], $mm, PREG_SET_ORDER)){
				foreach ($mm AS $m) $matchers[$m[1]] = preg_split('/\s+/', trim($m[2]))
			}
			if (preg_match_all('/(?:^|\n)\s*redir(?:ect)?\s+(@\w+|\S+)/', $b['block'], $rr, PREG_SET_ORDER)){
				foreach ($rr AS $r){
					if (str_starts_with($r[1], '@')) $redirected = array_merge($redirected, $matchers[substr($r[1], 1)] ?? [])
					else $pureRedirect = true
				}
			}
			$apps[] = static::normalizeApp($appName, $hostnames, $redirected, $pureRedirect, $env)
		}
	}
	return $apps
}

// nginx adapter: server blocks -> canonical app records. Globs creds.ini [discovery] nginx = <pattern>
// (default /etc/nginx/sites-enabled/*). server_name gives the hosts; a `return 30x` or permanent rewrite marks
// a redirect-only block. nginx carries no env marker, so env follows the dev./stage. host prefix.
static nginxApps {
	// Keyed by primary host so the common http+https split (two server blocks, same server_name) collapses to one
	// record, preferring the non-redirect block over a `return 30x` companion.
	$byHost = []
	$skip = static::hiddenSites()
	$pattern = (string)(%creds->discovery?->nginx ?? '/etc/nginx/sites-enabled/*')
	foreach (glob($pattern) ?: [] AS $file){
		if (is_dir($file)) continue
		$appName = preg_replace('/\.conf$/', '', basename($file))
		if (in_array($appName, $skip, true)) continue
		$src = (string)@file_get_contents($file)
		foreach (static::nginxBlocks($src) AS $block){
			if (!preg_match_all('/\bserver_name\s+([^;]+);/', $block, $sn, PREG_SET_ORDER)) continue
			$hostnames = []
			foreach ($sn AS $s){
				foreach (preg_split('/\s+/', trim($s[1])) AS $host){
					$host = trim($host)
					if ($host === '' || $host === '_' || !str_contains($host, '.')) continue
					if (!in_array($host, $hostnames, true)) $hostnames[] = $host
				}
			}
			if (!$hostnames) continue
			$pureRedirect = (bool)preg_match('/\breturn\s+30\d\b/', $block) || (bool)preg_match('/\brewrite\b[^;]+\b(permanent|redirect)\s*;/', $block)
			$rec = static::normalizeApp($appName, $hostnames, [], $pureRedirect, 'prod')
			$key = $rec['host']
			if (!isset($byHost[$key]) || ($byHost[$key]['redirect'] && !$rec['redirect'])) $byHost[$key] = $rec
		}
	}
	return array_values($byHost)
}

// Extracts top-level `server { ... }` blocks from an nginx config, brace-depth aware so nested location{}
// blocks stay inside their parent. Returns each block's inner text.
static nginxBlocks($src){
	// Strip line comments first so a '#'-commented brace does not unbalance the depth scan. (A separate
	// server block that only redirects www is still listed on its own; it is not folded into the apex.)
	$src = preg_replace('/#[^\n]*/', '', (string)$src)
	$blocks = []
	$len = strlen($src)
	$i = 0
	while (($pos = strpos($src, 'server', $i)) !== false){
		$rest = substr($src, $pos + 6)
		if (!preg_match('/^\s*\{/', $rest, $m)){
			$i = $pos + 6
			continue
		}
		$start = $pos + 6 + strlen($m[0])
		$depth = 1
		$j = $start
		while ($j < $len && $depth > 0){
			$ch = $src[$j]
			if ($ch === '{') $depth++
			elseif ($ch === '}') $depth--
			$j++
		}
		$blocks[] = substr($src, $start, $j - 1 - $start)
		$i = $j
	}
	return $blocks
}

static visitors($db){
	if (!is_array($db) || empty($db['host']) || empty($db['database'])) return []
	try {
		$pdo = new \PDO('mysql:host='.$db['host'].';dbname='.$db['database'], (string)($db['user'] ?? ''), (string)($db['password'] ?? ''), [\PDO::ATTR_TIMEOUT => 3, \PDO::ATTR_ERRMODE => \PDO::ERRMODE_EXCEPTION])
		return array_map('intval', $pdo->query('SELECT host, COUNT(DISTINCT token) c FROM visitors GROUP BY host')->fetchAll(\PDO::FETCH_KEY_PAIR))
	}
	catch (\Throwable $e){
		return []
	}
}

static whatsapp {
	$list = []
	foreach (glob(static::base().'/config/wa*.js') ?: [] AS $f){
		if (!preg_match("/\\(\\s*'([a-z0-9]+)'\\s*,\\s*(\\d+)\\s*,\\s*'([^']+)'/", (string)@file_get_contents($f), $m)) continue
		$port = (int)$m[2]
		$res = null
		try {
			$res = json_decode((string)HTTP('http://127.0.0.1:'.$port.'/health', ['secret: '.$m[3]]), true)
		}
		catch (\Throwable $e){}
		$entry = ['instance' => $m[1], 'port' => $port, 'status' => is_array($res) ? (string)($res['status'] ?? 'unknown') : 'offline']
		if (is_array($res)){
			$entry['uptime'] = (int)($res['uptime'] ?? 0)
			$entry['webhook'] = (bool)($res['webhook'] ?? false)
			if (((string)($res['status'] ?? '')) !== 'ready'){
				$qr = null
				try {
					$qr = json_decode((string)HTTP('http://127.0.0.1:'.$port.'/qr', ['secret: '.$m[3]]), true)
				}
				catch (\Throwable $e){}
				if (is_array($qr) && !empty($qr['qr'])) $entry['qr'] = (string)$qr['qr']
			}
		}
		$list[] = $entry
	}
	return $list
}

static collect {
	$apps = static::discoverApps()
	$errors = []
	foreach (glob(dirname(static::base()).'/*/data/errors.json') AS $file){
		$data = json_decode((string)@file_get_contents($file), true)
		if (!is_array($data) || !$data) continue
		$occ = 0
		$latest = ''
		$byHost = []
		foreach ($data AS $e){
			$c = (int)($e['count'] ?? 1)
			$occ += $c
			$lo = (string)($e['lastOccurred'] ?? '')
			if ($lo > $latest) $latest = $lo
			$h = (string)($e['host'] ?? '')
			if ($h === '') continue
			$byHost[$h]['occurrences'] = (int)($byHost[$h]['occurrences'] ?? 0) + $c
			$byHost[$h]['unique'] = (int)($byHost[$h]['unique'] ?? 0) + 1
			if ($lo > (string)($byHost[$h]['latest'] ?? '')) $byHost[$h]['latest'] = $lo
		}
		$errors[basename(dirname(dirname($file)))] = ['unique' => count($data), 'occurrences' => $occ, 'latest' => $latest, 'byHost' => $byHost, 'entries' => array_slice($data, 0, 100, true)]
	}
	$mem = ['MemTotal' => 0, 'MemAvailable' => 0]
	foreach (explode(lf, (string)@file_get_contents('/proc/meminfo')) AS $line){
		if (preg_match('/^(MemTotal|MemAvailable):\s+(\d+)/', $line, $mm)) $mem[$mm[1]] = (int)$mm[2] * 1024
	}
	$load = function_exists('sys_getloadavg') ? sys_getloadavg() : [0, 0, 0]
	$cpu = max(1, substr_count((string)@file_get_contents('/proc/cpuinfo'), 'processor'))
	$diskTotal = (int)@disk_total_space('/')
	$diskFree = (int)@disk_free_space('/')
	$uptime = (int)(float)strtok((string)@file_get_contents('/proc/uptime'), ' ')
	$version = '?'
	if (preg_match("/const phlo\\s*=\\s*'([^']+)'/", (string)@file_get_contents(static::base().'/phlo/phlo.php'), $vm)) $version = $vm[1]
	$engineFiles = glob(static::base().'/phlo/*.php') ?: [static::base().'/phlo/phlo.php']
	$buildTs = 0
	foreach ($engineFiles AS $ef) $buildTs = max($buildTs, (int)@filemtime($ef))
	$build = $buildTs ? date('Y-m-d H:i', $buildTs) : '?'
	$visitors = static::visitors(static::localCreds()['mysql'] ?? null)
	return [
		'server' => gethostname(),
		'phlo' => $version,
		'build' => $build,
		'time' => time(),
		'visitors' => $visitors,
		'metrics' => [
			'cpu_count' => $cpu,
			'load1' => round($load[0] ?? 0, 2),
			'mem_total' => $mem['MemTotal'],
			'mem_used' => max(0, $mem['MemTotal'] - $mem['MemAvailable']),
			'disk_total' => $diskTotal,
			'disk_used' => max(0, $diskTotal - $diskFree),
			'uptime_sec' => $uptime,
		],
		'apps' => $apps,
		'errors' => $errors,
		'whatsapp' => static::whatsapp(),
	]
}

// --- Poller (CLI command `php app.php fleet::poll`, runs as frankenphp via /etc/cron.d/fleet-poll) ---
// Collects every node into the dashboard cache (data/fleet/<node>.json). The web (frankenphp) only reads that
// cache and therefore never blocks on a slow/dead node. Replaces the old raw bin/fleet-poll.php.

// Parallel reachability check of all hosts at once. curl_multi instead of HTTP() because HTTP() does one
// request at a time and ~36 hosts sequentially do not fit within the 2-min poll cycle.
static ping($hosts, $local = false){
	$hosts = array_values(array_unique($hosts))
	if (!$hosts || !function_exists('curl_multi_init')) return []
	$mh = curl_multi_init()
	$handles = []
	foreach ($hosts AS $host){
		$ch = curl_init()
		curl_setopt_array($ch, [
			CURLOPT_URL => 'https://'.$host.'/',
			CURLOPT_NOBODY => true,
			CURLOPT_RESOLVE => $local ? [$host.':443:127.0.0.1'] : [],
			CURLOPT_SSL_VERIFYPEER => false,
			CURLOPT_SSL_VERIFYHOST => false,
			CURLOPT_FOLLOWLOCATION => false,
			CURLOPT_CONNECTTIMEOUT => 3,
			CURLOPT_TIMEOUT => 5,
			CURLOPT_RETURNTRANSFER => true,
		])
		curl_multi_add_handle($mh, $ch)
		$handles[$host] = $ch
	}
	$running = null
	while (true){
		$status = curl_multi_exec($mh, $running)
		if ($running <= 0 || $status !== CURLM_OK) break
		curl_multi_select($mh, 1)
	}
	$out = []
	foreach ($handles AS $host => $ch){
		$out[$host] = ['code' => (int)curl_getinfo($ch, CURLINFO_RESPONSE_CODE), 'ms' => (int)round(curl_getinfo($ch, CURLINFO_TOTAL_TIME) * 1000)]
		curl_multi_remove_handle($mh, $ch)
	}
	curl_multi_close($mh)
	return $out
}

static attachPing($data, $local = false){
	if (!is_array($data) || empty($data['apps'])) return $data
	$ping = static::ping(array_column($data['apps'], 'host'), $local)
	foreach ($data['apps'] AS $i => $a){
		$data['apps'][$i]['code'] = $ping[$a['host']]['code'] ?? 0
		$data['apps'][$i]['ms'] = $ping[$a['host']]['ms'] ?? 0
	}
	return $data
}

static wrapNode($name, $mode, $data){
	$rec = is_array($data) ? $data : []
	$rec['node'] = $name
	$rec['label'] = static::label($name)
	$rec['mode'] = $mode
	$rec['ok'] = is_array($data) && isset($data['server'])
	$rec['polled'] = time()
	return $rec
}

// Writes one node cache. Runs as frankenphp, so the cache directly gets the right owner
// (chown is best-effort, no-op outside root).
static storeNode($name, $data){
	$dir = data.'fleet'
	if (!is_dir($dir)) @mkdir($dir, 0775, true)
	$file = $dir.'/'.$name.'.json'
	file_put_contents($file, json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES))
	$owner = static::webUser()
	@chown($file, $owner)
	@chgrp($file, $owner)
}

// Poll cycle: local node in-process via collect(); pull peers via HMAC GET /api/feed. Then
// new prod errors to the central messaging endpoint. (ssh mode is retired: everything is pull.)
static poll {
	static::storeNode('local', static::wrapNode('local', 'self', static::attachPing(static::collect(), true)))
	$done = ['local']
	foreach ((static::peers() ?? []) AS $name => $cfg){
		if (((string)($cfg->upstream ?? void)) === '1') continue
		$mode = (string)($cfg->mode ?? 'pull')
		$data = null
		if ($mode === 'pull'){
			$url = trim((string)($cfg->url ?? ''))
			$secret = (string)($cfg->secret ?? '')
			if ($url !== '' && $secret !== ''){
				try {
					$data = json_decode((string)HTTP($url.'/api/feed', static::signHeaders($secret)), true)
				}
				catch (\Throwable $e){
					$data = null
				}
			}
		}
		static::storeNode($name, static::wrapNode($name, $mode, static::attachPing($data, false)))
		$done[] = $name
	}
	$pushed = static::reportErrors()
	return ['ok' => true, 'nodes' => $done, 'reported' => $pushed]
}

// Pushes new PROD errors to POST /api/notify (secret) -> dashboard inbox + subscription dispatch.
// Dev/stage are skipped (error reporting is off on dev). Each error hash notifies at most once per hour
// (throttle via reported.json) and only for errors seen in the last 15 min. Via HTTP() (no raw curl).
static reportErrors {
	$c = %creds->notify ?? null
	$url = (string)($c->url ?? void)
	$secret = (string)($c->secret ?? void)
	if ($url === void || $secret === void) return 0
	$cooldown = 3600
	$stateFile = data.'fleet/reported.json'
	$raw = is_file($stateFile) ? (array)json_decode((string)file_get_contents($stateFile), true) : []
	$cut = time() - 86400
	$reported = array_filter($raw, fn($t) => (int)$t > $cut)
	$pushed = 0
	foreach (glob(data.'fleet/*.json') ?: [] AS $f){
		if (basename($f) === 'reported.json') continue
		$d = json_decode((string)file_get_contents($f), true)
		if (!is_array($d)) continue
		$node = (string)($d['node'] ?? basename($f, '.json'))
		$envByApp = []
		foreach ((array)($d['apps'] ?? []) AS $a) $envByApp[(string)($a['app'] ?? '')] = (string)($a['env'] ?? 'prod')
		foreach ((array)($d['errors'] ?? []) AS $app => $info){
			foreach ((array)($info['entries'] ?? []) AS $hash => $e){
				// Only notify errors from build-off (prod) environments. The engine stamps each
				// error with the build flag of the environment it occurred in (authoritative).
				if (!empty($e['build'])) continue
				// Fallback for entries written before the engine stamped build: caddy-derived env.
				if (!array_key_exists('build', $e) && ($envByApp[(string)$app] ?? 'prod') !== 'prod') continue
				$key = (string)$hash
				if (($reported[$key] ?? 0) > time() - $cooldown) continue
				$ts = \DateTime::createFromFormat('j-n-Y H:i:s', (string)($e['lastOccurred'] ?? ''))
				if (!$ts || $ts->getTimestamp() < time() - 900) continue
				try {
					HTTP($url, ['secret: '.$secret], true, [
						'app' => (string)$app,
						'type' => 'error',
						'level' => 'error',
						'title' => substr((string)($e['msg'] ?? 'Unknown error'), 0, 200),
						'body' => trim((string)($e['file'] ?? '').' · '.($e['count'] ?? 1).'× · last '.($e['lastOccurred'] ?? '')),
						'server' => $node,
						'host' => (string)($e['host'] ?? $app),
					])
				}
				catch (\Throwable $ex){
					continue
				}
				$reported[$key] = time()
				$pushed++
			}
		}
	}
	if ($pushed || count($reported) !== count($raw)) file_put_contents($stateFile, json_encode($reported))
	return $pushed
}

static geoEnrich($pdo, $rows, $ipgeoKey){
	$ips = []
	foreach ($rows AS $r) if (!empty($r['IP'])) $ips[$r['IP']] = true
	$ips = array_keys($ips)
	if (!$ips) return $rows
	$geo = []
	$ph = implode(',', array_fill(0, count($ips), '?'))
	$st = $pdo->prepare('SELECT ip, city, country, lat, lon, isp FROM lookup WHERE ip IN ('.$ph.')')
	$st->execute($ips)
	foreach ($st->fetchAll(\PDO::FETCH_ASSOC) AS $g) $geo[$g['ip']] = $g
	if ($ipgeoKey !== '') foreach ($ips AS $ip){
		if (isset($geo[$ip]) || !filter_var($ip, FILTER_VALIDATE_IP, FILTER_FLAG_NO_PRIV_RANGE | FILTER_FLAG_NO_RES_RANGE)) continue
		$res = null
		try {
			$res = @json_decode((string)HTTP('https://api.ipgeolocation.io/ipgeo?apiKey='.$ipgeoKey.'&ip='.$ip))
		}
		catch (\Throwable $e){}
		if (!is_object($res) || !isset($res->country_code2)) continue
		$g = ['ip' => $ip, 'city' => (string)($res->city ?? ''), 'country' => (string)($res->country_code2 ?? ''), 'lat' => (string)($res->latitude ?? ''), 'lon' => (string)($res->longitude ?? ''), 'isp' => (string)($res->isp ?? '')]
		try {
			$pdo->prepare('INSERT IGNORE INTO lookup (ip, city, country, lat, lon, isp) VALUES (?,?,?,?,?,?)')->execute([$g['ip'], $g['city'], $g['country'], $g['lat'], $g['lon'], $g['isp']])
		}
		catch (\Throwable $e){}
		$geo[$ip] = $g
	}
	foreach ($rows AS $i => $r){
		$g = $geo[$r['IP'] ?? ''] ?? []
		$rows[$i]['city'] = $g['city'] ?? null
		$rows[$i]['country'] = $g['country'] ?? null
		$rows[$i]['isp'] = $g['isp'] ?? null
		$rows[$i]['lat'] = $g['lat'] ?? null
		$rows[$i]['lon'] = $g['lon'] ?? null
	}
	return $rows
}

static visitorReport {
	$ini = static::localCreds()
	$db = $ini['mysql'] ?? null
	$ipgeoKey = (string)($ini['ipgeolocation'] ?? '')
	if (!is_array($db) || empty($db['host']) || empty($db['database'])) return []
	try {
		$pdo = new \PDO('mysql:host='.$db['host'].';dbname='.$db['database'].';charset=utf8mb4', (string)($db['user'] ?? ''), (string)($db['password'] ?? ''), [\PDO::ATTR_TIMEOUT => 5, \PDO::ATTR_ERRMODE => \PDO::ERRMODE_EXCEPTION])
		if (!$pdo->query("SHOW TABLES LIKE 'visitors'")->fetchColumn()) return []
	}
	catch (\Throwable $e){
		return []
	}
	$now = time()
	$d30 = $now - 86400 * 30
	try {
		$recent = static::geoEnrich($pdo, $pdo->query('SELECT * FROM visitors ORDER BY changed DESC LIMIT 200')->fetchAll(\PDO::FETCH_ASSOC) ?: [], $ipgeoKey)
		try {
			$ids = array_filter(array_map(fn($r) => (string)($r['id'] ?? ''), $recent))
			if ($ids){
				$in = implode(comma, array_map(fn($id) => $pdo->quote($id), $ids))
				$byVisitor = []
				foreach ($pdo->query("SELECT visitor, page, SUM(active_seconds) AS active_seconds, SUM(beats) AS beats, MIN(created) AS created FROM visitor_pages WHERE visitor IN ($in) GROUP BY visitor, page ORDER BY visitor, MIN(created) ASC")->fetchAll(\PDO::FETCH_ASSOC) ?: [] AS $pr){
					$byVisitor[$pr['visitor']][] = $pr
				}
				foreach ($recent AS &$r){
					$r['pages'] = $byVisitor[(string)($r['id'] ?? '')] ?? []
				}
				unset($r)
			}
		}
		catch (\Throwable $e){}
		return [
			'active' => (int)$pdo->query('SELECT COUNT(id) FROM visitors WHERE changed > '.($now - 300))->fetchColumn(),
			'recent' => $recent,
			'countries' => $pdo->query('SELECT l.country AS country, COUNT(v.id) AS count FROM visitors v JOIN lookup l ON v.IP = l.ip WHERE v.IP != "" AND l.country IS NOT NULL AND l.country != "" AND v.changed > '.$d30.' GROUP BY l.country ORDER BY count DESC LIMIT 5')->fetchAll(\PDO::FETCH_ASSOC) ?: [],
			'browsers' => $pdo->query('SELECT REGEXP_REPLACE(browser, " [0-9].*$", "") AS browser, COUNT(id) AS count FROM visitors WHERE IP IS NOT NULL AND IP != "" AND browser != "" AND browser != "Unknown" AND changed > '.$d30.' GROUP BY REGEXP_REPLACE(browser, " [0-9].*$", "") ORDER BY count DESC LIMIT 5')->fetchAll(\PDO::FETCH_ASSOC) ?: [],
			'referrers' => $pdo->query('SELECT referrer, COUNT(id) AS count FROM visitors WHERE referrer IS NOT NULL AND changed > '.$d30.' GROUP BY referrer ORDER BY count DESC LIMIT 8')->fetchAll(\PDO::FETCH_ASSOC) ?: [],
		]
	}
	catch (\Throwable $e){
		return []
	}
}

// Federation: a peer node lets the master authenticate a master user for one of its
// subdashboards. The node signs time.auth.email.module with its fleet secret; returns the matching node name.
static authFed($email, $module){
	return static::verifyPeer(fn($t) => $t.'.auth.'.(string)$email.'.'.(string)$module)
}

static label($name){
	if ($name === 'local') return (string)(%creds->node->label ?? 'Local')
	$peer = static::peers()?->$name ?? null
	return (string)($peer->label ?? $name)
}

static cached($name){
	$file = data.'fleet/'.$name.'.json'
	if (!is_file($file)) return null
	$data = json_decode((string)file_get_contents($file), true)
	if (!is_array($data)) return null
	$data['age'] = time() - (int)($data['time'] ?? 0)
	$data['label'] ??= static::label($name)
	return $data
}

static clearCachedErrors($name, $app = void){
	$file = data.'fleet/'.$name.'.json'
	if (!is_file($file)) return
	$data = json_decode((string)file_get_contents($file), true)
	if (!is_array($data)) return
	if ($app !== void && $app !== '') unset($data['errors'][$app])
	else $data['errors'] = []
	file_put_contents($file, json_encode($data, JSON_UNESCAPED_UNICODE | JSON_UNESCAPED_SLASHES))
}

static nodes {
	$out = ['local']
	$peers = static::peers()
	if ($peers) foreach ($peers AS $name => $peer) ((string)($peer->upstream ?? void)) === '1' || $out[] = $name
	return $out
}

static actions => ['errors-reset', 'rebuild', 'ws-restart']

static runAction($command, $app = void){
	$appsBase = dirname(static::base())
	if ($command === 'errors-reset'){
		if ($app !== void && $app !== ''){
			if (!preg_match('/^[a-z0-9._-]+$/i', (string)$app) || str_contains((string)$app, '..')) return 'invalid app'
			$path = $app === 'dashboard' ? data.'errors.json' : $appsBase.'/'.$app.'/data/errors.json'
			return @file_put_contents($path, '{}') !== false ? 'errors of '.$app.' cleared' : 'could not clear errors'
		}
		$n = 0
		foreach (glob($appsBase.'/*/data/errors.json') AS $f) if (@file_put_contents($f, '{}') !== false) $n++
		@file_put_contents(data.'errors.json', '{}')
		return $n.' error files cleared'
	}
	if ($command === 'rebuild'){
		build::run()
		return 'app rebuilt'
	}
	if ($command === 'ws-restart'){
		@shell_exec(static::wsRestart())
		return 'websocket restarted'
	}
	return 'unknown action'
}

static authManage($command, $app = void){
	return static::verifyPeer(fn($t) => $t.'.'.(string)$command.'.'.(string)$app, 'manage')
}

static manage($node, $command, $app = void){
	if (!in_array($command, static::actions())) return ['ok' => false, 'msg' => 'invalid action']
	if ($node === 'local') return ['ok' => true, 'msg' => static::runAction($command, $app)]
	$peer = static::peers()?->$node ?? null
	if (!$peer) return ['ok' => false, 'msg' => 'unknown node']
	if (((string)($peer->mode ?? 'pull')) !== 'pull') return ['ok' => false, 'msg' => 'not available for headless node']
	$url = (string)($peer->url ?? void)
	$secret = (string)($peer->secret ?? void)
	if ($url === void || $secret === void) return ['ok' => false, 'msg' => 'no creds']
	$headers = static::signHeaders($secret, (string)$command.'.'.(string)$app)
	try {
		$res = json_decode((string)HTTP($url.'/api/manage', $headers, true, ['command' => $command, 'app' => (string)$app]), true)
		return is_array($res) ? $res : ['ok' => false, 'msg' => 'no response']
	}
	catch (\Throwable $e){
		return ['ok' => false, 'msg' => 'node unreachable']
	}
}

route GET api feed {
	%security->api
	if (!static::authPeer()) return output(['error' => 'unauthorized'], code: 401)
	return output(static::feedData())
}

route GET api visitors {
	%security->api
	if (!static::authPeer()) return output(['error' => 'unauthorized'], code: 401)
	return output(static::visitorReport())
}

route POST api auth {
	%security->api
	$email = trim((string)(%payload->email ?? void))
	$pass = (string)(%payload->password ?? void)
	$module = trim((string)(%payload->module ?? void))
	$node = static::authFed($email, $module)
	if (!$node || !class_exists('user')) return output(['ok' => false, 'error' => 'unauthorized'], code: 401)
	$u = user::verify($email, $pass)
	if (!$u || !$u->active || !$u->canServer($node) || ($module !== '' && !$u->canModule($module))) return output(['ok' => false, 'error' => 'denied'])
	return output(['ok' => true, 'user' => ['id' => $u->id, 'name' => $u->displayName, 'email' => $u->email, 'role' => $u->role]])
}

route POST api manage {
	%security->api
	$command = (string)(%payload->command ?? void)
	$app = (string)(%payload->app ?? void)
	if (!static::authManage($command, $app) || !in_array($command, static::actions())) return output(['ok' => false, 'msg' => 'unauthorized'], code: 401)
	return output(['ok' => true, 'msg' => static::runAction($command, $app)])
}

route async POST manage $node $command $app= {
	if (!auth::user()?->canServer($node)) return apply(error: 'No access to this server')
	$app ??= ''
	$res = fleet::manage($node, $command, $app)
	if (!($res['ok'] ?? false)) return apply(error: ($res['msg'] ?? 'failed'))
	if ($command === 'errors-reset'){
		fleet::clearCachedErrors($node, $app)
		return apply(toast: '✓ '.($res['msg'] ?? 'cleared'), outer: ['.dash' => overview::errorsView($node, $app)])
	}
	return apply(toast: '✓ '.($res['msg'] ?? 'done'))
}
