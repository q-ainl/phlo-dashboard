method __construct(public $conf)

prop name => trim(explode(',', explode('{', $this->conf, 2)[0])[0])
prop root {
	if ($r = regex('/^\s*root\s+\*?\s*(\S+)/m', $this->conf)[1] ?? void) return static::stripWww($r)
	preg_match_all('/^[ \t]*import[ \t]+(\S+)([^\n]*)/m', $this->conf, $ms, PREG_SET_ORDER)
	foreach ($ms AS $imp){
		if (($def = static::snippetRoot($imp[1])) === void) continue
		$args = preg_split('/\s+/', trim($imp[2]), -1, PREG_SPLIT_NO_EMPTY)
		return static::stripWww(preg_replace_callback('/\{args\[(\d+)\]\}/', fn($m) => $args[(int)$m[1]] ?? '', $def))
	}
	return void
}
static stripWww($r) => str_ends_with((string)$r, '/www') ? substr((string)$r, 0, -4) : (string)$r
static snippetRoot($name){
	foreach (array_merge([fleet::base().'/config/Caddyfile'], glob(fleet::base().'/sites/*.caddy') ?: []) AS $f){
		if (preg_match('/\('.preg_quote($name, '/').'\)\s*\{(.*?)^\}/ms', (string)@file_get_contents($f), $m) && ($r = regex('/^\s*root\s+\*?\s*(\S+)/m', $m[1])[1] ?? void)) return $r
	}
	return void
}
prop isDev => (bool)preg_match('/\bbuild\s*:\s*true\b/', (string)@file_get_contents("$this->root/www/app.php"))
prop data => json_read("$this->root/data/app.json")
prop version {
	$file = $this->isDev ? "$this->root/app.phlo" : "$this->root/app.php"
	if (!is_file($file)) return '??'
	$pattern = $this->isDev ? '/prop\s+version\s*=\s*["\']?([^\s"\r\n\']+)["\']?/' : '/public\s+\$version\s*=\s*["\']?([^;"\'\r\n]+)["\']?\s*;/'
	return regex($pattern, file_get_contents($file))[1] ?? '??'
}
prop deployed {
	$build = is_file($file = "$this->root/data/build.json") ? json_decode((string)@file_get_contents($file)) : null
	if (!($build->commit ?? null)) return null
	return substr((string)$build->commit, 0, 7).' · '.str_replace('T', ' ', substr((string)($build->built ?? void), 0, 16))
}
prop hasCreds => is_file("$this->root/data/creds.ini")
prop database => $this->hasCreds ? (($db = parse_ini_file("$this->root/data/creds.ini", true, INI_SCANNER_RAW)['mysql']['database'] ?? null) === (string)(%creds->mysql?->database ?? 'control') ? null : $db) : null
prop control => $this->isDev && !strpos($this->root, 'placeholder') ? static::controlFrom((string)@file_get_contents("$this->root/www/app.php")) : null

// The Control Center only mounts under build+debug and defaults to /phlo; parse the remote entry line by
// line, dropping comments, so a commented example line is not read as config and an implicit default counts.
static controlFrom($src){
	$build = $debug = false
	$path = 'phlo'
	foreach (explode(lf, $src) AS $line){
		$code = trim(explode('//', $line, 2)[0])
		if ($code === void || $code[0] === '#') continue
		preg_match('/\bbuild:\s*true/', $code) && $build = true
		preg_match('/\bdebug:\s*true/', $code) && $debug = true
		if (preg_match('/\bcontrol:\s*false/', $code)) return null
		preg_match('/\bcontrol:\s*[\'"]([a-zA-Z0-9_-]+)[\'"]/', $code, $m) && $path = $m[1]
	}
	return $build && $debug ? $path : null
}
prop siteAuth => $this->isDev && is_file($f = "$this->root/data/auth.ini") && ($s = parse_ini_file($f, true, INI_SCANNER_RAW)['site'] ?? null) && !empty($s['user']) ? rawurlencode($s['user']).':'.rawurlencode($s['password'] ?? '').'@' : void

view:
<div.host-row>
	<div.host-header>
		<div.host-hostname>$this->name</div>
		<span.environment-badge>$this->version {( $this->isDev ? 'dev' : 'prod' )}</span>
		<if $this->deployed>
			<span.environment-badge title="Deployed build">$this->deployed</span>
		</if>
	</div>
	<div.host-content>
		<if $visitors = site::visitors()[$this->name] ?? null>
			<a.host-visitors href="/visitors/q=$this->name" target=_blank>
				{{ overview::icon('eye', 12) }}
				<span>$visitors</span>
			</a>
		</if>
		<if $this->database>
			<a.host-database.async href="/dbadmin" title="Open database manager">
				{{ overview::icon('database', 12) }}
				<span.database-name>$this->database</span>
				<span.database-size>{{ size_human(site::databases()[$this->database] ?? 0) }}</span>
			</a>
		</if>
		<div.host-actions>
			<if $this->control>
				<a.btn.btn-dashboard href="https://$this->name/$this->control" target=_blank title="Control Center">
					{{ overview::icon('panel', 12) }}
				</a>
			</if>
			<a.btn.btn-site href="https://$this->siteAuth$this->name/" target=_blank title="Open Site">
				{{ overview::icon('external', 12) }}
			</a>
		</div>
	</div>
</div>
