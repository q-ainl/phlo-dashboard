@ extends: model
@ summary: Central notifications. Apps push via POST /notify (secret); logged-in users see their server-scoped inbox. Subscriptions (subscription module) deliver here.

view: $this->title

static table = 'messages'
static order = 'created DESC'

// Category colour by message type (matches emoji/label below).
static typeCls($type) => ['user' => 'blue', 'payment' => 'emerald', 'order' => 'emerald'][(string)$type] ?? 'muted'

// Card/badge colour: severity (level) wins, otherwise the category (type).
static cls($level, $type) => (string)$level === 'error' ? 'error' : ((string)$level === 'warn' ? 'warn' : static::typeCls($type))

static emoji($type) => ['user' => '🧍', 'payment' => '🪙', 'order' => '🛒', 'error' => '⚠️', 'warn' => '⚠️', 'info' => '🔔'][(string)$type] ?? '🔔'

static label($type) => ['user' => 'User', 'payment' => 'Payment', 'order' => 'Order', 'error' => 'Error', 'warn' => 'Warning', 'info' => 'Info'][(string)$type] ?? 'Notice'

static feed($limit = 100){
	$u = auth::user()
	if (!$u) return []
	$out = []
	foreach (message::records(order: 'created DESC', limit: $limit) AS $m){
		if ($u->canServer((string)$m->server)) $out[] = $m
	}
	return $out
}

static unread {
	$u = auth::user()
	if (!$u) return 0
	$n = 0
	foreach (message::records(read_at: null, limit: 200) AS $m) if ($u->canServer((string)$m->server)) $n++
	return $n
}

static inbox {
	$msgs = static::feed()
	$rows = void
	foreach ($msgs AS $m){
		$cls = static::cls($m->level, $m->type)
		$src = tag('span', overview::icon('server', 12, 'muted').tag('span', esc((string)$m->server)), class: 'msg-src').tag('span', esc((string)$m->app), class: 'msg-app').tag('span', age_human(time() - (int)$m->created).' ago', class: 'msg-time')
		$line = tag('span', static::emoji((string)$m->type).' '.static::label((string)$m->type), class: 'msg-badge '.$cls).tag('span', esc((string)$m->title), class: 'msg-title')
		$body = trim((string)$m->body) !== '' ? tag('p', esc((string)$m->body), class: 'msg-body') : void
		$rows .= tag('div', tag('div', $src, class: 'msg-head').tag('div', $line, class: 'msg-line').$body, class: 'msg-card '.$cls.($m->read_at ? '' : ' unread'))
	}
	$head = tag('header', tag('div', tag('h1', '🔔 Notifications', class: 'dash-title').tag('p', count($msgs).' notifications', class: 'dash-sub')), class: 'dash-head')
	return tag('div', $head.tag('div', $rows ?: tag('p', 'No notifications.', class: 'msg-empty'), class: 'msg-feed'), class: 'dash')
}

route both GET messages {
	%app->active = 'message'
	$out = static::inbox()
	$u = auth::user()
	if ($u){
		$ids = []
		foreach (message::records(read_at: null, limit: 200) AS $m) if ($u->canServer((string)$m->server)) $ids[] = $m->id
		$ids && message::change('read_at IS NULL AND id IN ('.implode(comma, array_fill(0, count($ids), qm)).')', ...$ids, read_at: time())
	}
	main($out, 'Notifications')
}

route POST api notify {
	%security->api
	$secret = (string)($_SERVER['HTTP_SECRET'] ?? void)
	$expect = (string)(%creds->notify->secret ?? void)
	if ($expect === void || !hash_equals($expect, $secret)) return error('Unauthorized', 401)
	$p = %payload
	$m = message::create(
		id: token(10),
		app: substr(trim((string)($p->app ?? 'unknown')), 0, 60),
		type: substr(trim((string)($p->type ?? 'info')), 0, 40),
		level: substr(trim((string)($p->level ?? 'info')), 0, 20),
		title: substr(trim((string)($p->title ?? '')), 0, 255),
		body: trim((string)($p->body ?? '')),
		server: substr(trim((string)($p->server ?? 'local')), 0, 40),
		host: substr(trim((string)($p->host ?? '')), 0, 100),
		user_id: trim((string)($p->user ?? '')) ?: null,
		read_at: null,
		created: time(),
	)
	phlo_exists('subscription') && subscription::dispatch($m)
	return output(['ok' => true, 'id' => $m->id])
}

static schema => arr (
	id: field (type: 'token', length: 10, title: 'ID', list: false, record: false),
	app: field (type: 'text', title: 'App', length: 60),
	type: field (type: 'text', title: 'Type', length: 40),
	level: field (type: 'text', title: 'Level', length: 20),
	title: field (type: 'text', title: 'Title', length: 255, search: true),
	body: field (type: 'text', title: 'Content', length: 65000, list: false),
	server: field (type: 'text', title: 'Server', length: 40),
	host: field (type: 'text', title: 'Host', length: 100, list: false),
	user_id: field (type: 'text', title: 'User', length: 10, list: false),
	read_at: field (type: 'number', title: 'Read', list: false),
	created: field (type: 'datetime', title: 'Time'),
)

<style>
.msg-feed {
	display: flex
	flex-direction: column
	gap: .6rem
}
.msg-card {
	background: $surface
	border: 1px solid $border
	border-left: 3px solid $border
	border-radius: 10px
	padding: .75rem 1rem
}
.msg-card.error: border-left-color: $error
.msg-card.warn: border-left-color: $warn
.msg-card.emerald: border-left-color: $success
.msg-card.blue: border-left-color: $primary
.msg-card.unread {
	background: color-mix(in srgb, $surface 90%, $primary)
}
.msg-head {
	align-items: center
	color: $muted
	display: flex
	font-size: .75rem
	gap: .6rem
	margin-bottom: .35rem
}
.msg-src {
	align-items: center
	display: inline-flex
	font-family: monospace
	gap: .25rem
}
.msg-app {
	background: $bg
	border-radius: 4px
	padding: .05rem .4rem
}
.msg-time: margin-left: auto
.msg-line {
	align-items: center
	display: flex
	gap: .5rem
}
.msg-badge {
	border-radius: 999px
	font-size: .68rem
	font-weight: 700
	padding: .1rem .5rem
	text-transform: uppercase
}
.msg-badge.error: background: color-mix(in srgb, $error 20%, transparent)
.msg-badge.error: color: $error
.msg-badge.warn: background: color-mix(in srgb, $warn 20%, transparent)
.msg-badge.warn: color: $warn
.msg-badge.emerald: background: color-mix(in srgb, $success 20%, transparent)
.msg-badge.emerald: color: $success
.msg-badge.blue: background: color-mix(in srgb, $primary 20%, transparent)
.msg-badge.blue: color: $primary
.msg-badge.muted: background: $bg
.msg-badge.muted: color: $muted
.msg-title {
	color: $text
	font-weight: 600
}
.msg-body {
	color: $muted
	font-size: .85rem
	margin: .4rem 0 0
	white-space: pre-wrap
}
.msg-empty {
	color: $muted
	padding: 2rem
}
</style>
