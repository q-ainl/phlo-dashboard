@ summary: Published sites of the fleet, rendered as social preview cards with a sitemap page picker.

// A product is an app that publishes a site: discovery reports `seo` and `indexable` for the host. Every other
// host of the same app (staging, dev, admin endpoints, redirect aliases) becomes a layer on that one card.
// The grid renders from the fleet cache alone; homepage preview and sitemap are fetched on request and stored
// together in data/products/<app>.json. Subpage previews are fetched live and never stored.

static dir => data.'products/'
static key($app) => preg_replace('/[^a-z0-9._-]+/i', '-', (string)$app)
static id($app) => 'pd-'.preg_replace('/[^a-z0-9]+/i', '-', (string)$app)
static previewId($app) => 'pv-'.preg_replace('/[^a-z0-9]+/i', '-', (string)$app)
static file($app) => static::dir().static::key($app).'.json'

static stored($app){
	$file = static::file($app)
	if (!is_file($file)) return null
	$data = json_decode((string)file_get_contents($file), true)
	return is_array($data) && isset($data['home']) ? $data : null
}

static store($app, $data){
	is_dir(static::dir()) || @mkdir(static::dir(), 0775, true)
	$file = static::file($app)
	json_write($file, $data)
	$owner = fleet::webUser()
	@chown($file, $owner)
	@chgrp($file, $owner)
	return $data
}

static products {
	$user = auth::user()
	$rows = []
	foreach (fleet::nodes() AS $node){
		if (!$user?->canServer($node)) continue
		$feed = fleet::cached($node)
		if (!$feed) continue
		$visitors = (array)($feed['visitors'] ?? [])
		$errors = (array)($feed['errors'] ?? [])
		foreach ((array)($feed['apps'] ?? []) AS $app){
			$slug = (string)($app['app'] ?? void)
			$host = (string)($app['host'] ?? void)
			if ($slug === void || $host === void) continue
			$rows[] = $app + [
				'node' => $node,
				'nodeLabel' => (string)($feed['label'] ?? $node),
				'visitors' => (int)($visitors[$host] ?? 0),
				'errors' => (int)((($errors[$slug]['byHost'] ?? [])[$host]['occurrences']) ?? 0),
			]
		}
	}
	return static::group($rows)
}

static group($rows){
	$byApp = []
	foreach ($rows AS $row) $byApp[(string)$row['app']][] = $row
	$out = []
	foreach ($byApp AS $slug => $hosts){
		$published = array_values(array_filter($hosts, fn($h) => static::isPublished($h)))
		if (!$published) continue
		usort($published, fn($a, $c) => ((($c['env'] ?? void) === 'prod') <=> (($a['env'] ?? void) === 'prod')) ?: (strlen($a['host']) <=> strlen($c['host'])))
		$face = $published[0]
		$layers = array_values(array_filter($hosts, fn($h) => $h['host'] !== $face['host']))
		usort($layers, fn($a, $c) => (static::rank($a) <=> static::rank($c)) ?: strcmp($a['host'], $c['host']))
		$out[$slug] = ['app' => $slug, 'face' => $face, 'layers' => $layers]
	}
	uasort($out, fn($a, $c) => ((int)$c['face']['visitors'] <=> (int)$a['face']['visitors']) ?: strcmp($a['face']['host'], $c['face']['host']))
	return $out
}

static isPublished($h) => !empty($h['seo']) && !empty($h['indexable']) && empty($h['redirect'])

static rank($h){
	if (!empty($h['redirect'])) return 4
	if (static::isPublished($h)) return 1
	return ($h['env'] ?? void) === 'dev' ? 3 : 2
}

static envLabel($h){
	if (!empty($h['redirect'])) return 'redirect'
	if (($h['env'] ?? void) === 'dev') return 'dev'
	return static::isPublished($h) ? 'live' : 'staging'
}

// The environments you can preview: the published face first, then its layers. Redirect aliases are left out,
// they only answer with a 30x. The position in this list is the env index the routes take.
static hosts($product){
	$hosts = [$product['face']]
	foreach ((array)($product['layers'] ?? []) AS $layer) if (empty($layer['redirect'])) $hosts[] = $layer
	return $hosts
}

// What distinguishes a layer from the face: stage.phlo.tech under phlo.tech reads as 'stage'. A host on another
// domain keeps its full name.
static envName($host, $face){
	if ((string)$host === (string)$face) return en('live')
	return str_ends_with((string)$host, dot.$face) ? substr((string)$host, 0, -strlen((string)$face) - 1) : (string)$host
}

// Turns the (env, page, lang) a card is showing into an address. Every part is an index into data the fleet or
// the site itself produced, so this can only ever resolve to a page the site published.
static resolve($app, $env = 0, $i = -1, $lang = void){
	$product = static::products()[$app] ?? null
	if (!$product) return null
	$host = static::hosts($product)[(int)$env] ?? null
	if (!$host) return null
	$path = slash
	if ((int)$i >= 0){
		$page = ((array)((static::stored($app) ?? [])['pages'] ?? []))[(int)$i] ?? null
		if (!$page) return null
		$path = (string)($lang !== void ? (((array)($page['alt'] ?? []))[$lang] ?? $page['path']) : $page['path'])
	}
	return ['app' => (string)$app, 'host' => (string)$host['host'], 'url' => 'https://'.$host['host'].$path, 'env' => (int)$env, 'i' => (int)$i, 'lang' => $lang]
}

static GET($url){
	try {
		return (string)HTTP($url, ['Accept: text/html,application/xhtml+xml,application/xml'], agent: 'PhloDashboard/1.0 (+preview)', timeout: 8)
	}
	catch (\Throwable $e){
		return null
	}
}

// Preview images come from other hosts, and a strict img-src would block them. They are served from our own
// origin instead: the URL is never taken from the request but read from the stored preview, so this can only
// ever fetch an address the site itself published. The bytes are cached next to that preview.
static shotFile($app, $env = 0, $i = -1, $lang = void) => static::dir().static::key($app).'.img.'.(int)$env.dot.((int)$i < 0 ? 'home' : (int)$i).($lang !== void ? dash.static::key((string)$lang) : void)

// The image address is resolved here, never taken from the request: the home preview reads it from the stored
// file, a subpage reads it from the page the stored sitemap points at. Both can only be an address the site
// itself published.
static shotUrl($app, $env = 0, $i = -1, $lang = void){
	if ((int)$env === 0 && (int)$i < 0) return (string)(((array)((static::stored($app) ?? [])['home'] ?? []))['image'] ?? void)
	$view = static::resolve($app, $env, $i, $lang)
	if (!$view) return void
	$html = static::GET($view['url'])
	return $html === null ? void : (string)(static::meta($html, 'https://'.$view['host'])['image'] ?? void)
}

static shot($app, $env = 0, $i = -1, $lang = void){
	$file = static::shotFile($app, $env, $i, $lang)
	if (is_file($file) && filemtime($file) > time() - 86400) return (string)file_get_contents($file)
	$url = static::shotUrl($app, $env, $i, $lang)
	if ($url === void || !is_absolute_url($url)) return null
	try {
		$bytes = (string)HTTP($url, agent: 'PhloDashboard/1.0 (+preview)', timeout: 8)
	}
	catch (\Throwable $e){
		return null
	}
	// A site that lost its og:image answers with its catch-all page, so check the bytes really are an image
	// before caching or serving them: passing HTML off as an image only yields a broken picture.
	if ($bytes === void || !@getimagesizefromstring($bytes)) return null
	is_dir(static::dir()) || @mkdir(static::dir(), 0775, true)
	file_put_contents($file, $bytes)
	$owner = fleet::webUser()
	@chown($file, $owner)
	@chgrp($file, $owner)
	return $bytes
}

static fetch($host){
	$base = 'https://'.$host
	$html = static::GET($base.slash)
	if ($html === null) return null
	$map = static::GET($base.'/sitemap.xml')
	return [
		'host' => $host,
		'fetched' => time(),
		'home' => static::meta($html, $base),
		'pages' => $map === null ? [] : static::pages($map),
	]
}

static metaTags($html){
	$out = []
	foreach (regex_all('~<meta\s[^>]*>~i', (string)$html)[0] ?? [] AS $tag){
		$key = regex('~\b(?:property|name)\s*=\s*(?:(["\'])(.*?)\1|([^\s>]+))~i', $tag)
		$val = regex('~\bcontent\s*=\s*(?:(["\'])(.*?)\1|([^\s>]+))~is', $tag)
		$name = strtolower(trim((string)(($key[2] ?? void) !== void ? $key[2] : ($key[3] ?? void))))
		if ($name === void || isset($out[$name])) continue
		$out[$name] = html_entity_decode(trim((string)(($val[2] ?? void) !== void ? $val[2] : ($val[3] ?? void))), ENT_QUOTES | ENT_HTML5, 'UTF-8')
	}
	return $out
}

static meta($html, $base = void){
	$tags = static::metaTags($html)
	$title = (string)($tags['og:title'] ?? void)
	if ($title === void) $title = html_entity_decode(trim((string)(regex('~<title[^>]*>(.*?)</title>~is', (string)$html)[1] ?? void)), ENT_QUOTES | ENT_HTML5, 'UTF-8')
	return [
		'title' => $title,
		'descr' => (string)($tags['og:description'] ?? $tags['description'] ?? void),
		'image' => static::absolute((string)($tags['og:image'] ?? void), $base),
		'site' => (string)($tags['og:site_name'] ?? void),
		'url' => (string)($tags['og:url'] ?? void),
	]
}

static absolute($url, $base){
	if ($url === void || $base === void || is_absolute_url($url)) return $url
	return rtrim($base, slash).slash.ltrim($url, slash)
}

static pages($xml){
	$pages = []
	foreach (regex_all('~<url\b.*?</url>~is', (string)$xml)[0] ?? [] AS $block){
		$loc = (string)(regex('~<loc>(.*?)</loc>~is', $block)[1] ?? void)
		if (trim($loc) === void) continue
		$alt = []
		foreach (regex_all('~<xhtml:link[^>]*>~i', $block)[0] ?? [] AS $link){
			$lang = (string)(regex('~hreflang\s*=\s*["\']([^"\']+)["\']~i', $link)[1] ?? void)
			$href = (string)(regex('~href\s*=\s*["\']([^"\']+)["\']~i', $link)[1] ?? void)
			if ($lang === void || $href === void || $lang === 'x-default') continue
			$alt[$lang] = static::path($href)
		}
		$pages[] = ['path' => static::path($loc), 'alt' => $alt]
	}
	return $pages
}

static path($url){
	$path = (string)parse_url(trim(html_entity_decode((string)$url, ENT_QUOTES | ENT_HTML5, 'UTF-8')), PHP_URL_PATH)
	return $path === void ? slash : $path
}

static grouped($pages){
	$groups = []
	foreach ((array)$pages AS $i => $page){
		$path = (string)($page['path'] ?? slash)
		$trimmed = trim($path, slash)
		$group = ($trimmed === void || !str_contains($trimmed, slash)) ? slash : explode(slash, $trimmed)[0]
		$groups[$group][$i] = $path
	}
	if (isset($groups[slash])) $groups = [slash => $groups[slash]] + $groups
	return $groups
}

static langs($pages){
	$langs = []
	foreach ((array)$pages AS $page) foreach (array_keys((array)($page['alt'] ?? [])) AS $lang) $langs[$lang] = true
	ksort($langs)
	return array_keys($langs)
}

static preview($view, $meta){
	$image = (string)($meta['image'] ?? void)
	$src = '/product/image/'.rawurlencode((string)$view['app']).slash.(int)$view['env'].slash.(int)$view['i'].(($view['lang'] ?? void) !== void ? slash.rawurlencode((string)$view['lang']) : void)
	// Rendering never fetches: the image is requested by the browser, and one that no longer resolves is
	// swapped for the placeholder on error instead of leaving a broken picture in the card.
	$shot = $image !== void ? tag('img', null, src: $src, alt: void, loading: 'lazy', decoding: 'async', class: 'pd-img') : tag('div', overview::icon('globe', 26), class: 'pd-img pd-noimg')
	$domain = (string)(parse_url((string)($meta['url'] ?? void), PHP_URL_HOST) ?: $view['host'])
	$body = tag('span', esc(strtoupper($domain)), class: 'pd-domain')
	$body .= tag('h3', esc((string)($meta['title'] ?? void)) ?: en('No title'), class: 'pd-title')
	$body .= tag('p', esc((string)($meta['descr'] ?? void)) ?: tag('em', en('No description')), class: 'pd-descr')
	return $shot.tag('div', $body, class: 'pd-body')
}

// The preview is a link to the page it shows, like the card a social platform would render. The SPA router
// leaves it alone because it carries a target.
static previewBox($view, $meta){
	$url = (string)($meta['url'] ?? void) ?: (string)$view['url']
	return tag('div', tag('a', static::preview($view, $meta), href: $url, target: '_blank', class: 'pd-link'), id: static::previewId((string)$view['app']), class: 'pd-preview')
}

static blank($app){
	$body = tag('p', en('No preview loaded yet.'), class: 'pd-descr').tag('button', en('Load preview'), type: 'button', data_app: $app, class: 'pd-btn pd-load')
	$inner = tag('div', overview::icon('eye', 26), class: 'pd-img pd-noimg').tag('div', $body, class: 'pd-body')
	return tag('div', $inner, id: static::previewId($app), class: 'pd-preview pd-blank')
}

// One row of environments, always rendered so every card keeps the same height. Picking one previews that host
// at the same path, which is the only reason to look at a stage copy in the first place.
static envs($product, $current = 0){
	$face = (string)$product['face']['host']
	$out = void
	foreach (static::hosts($product) AS $n => $host){
		$dot = tag('span', void, class: 'st-dot '.overview::envState((int)($host['code'] ?? 0)))
		$label = tag('span', esc(static::envName((string)$host['host'], $face)))
		$out .= tag('button', $dot.$label, type: 'button', data_env: $n, title: (string)$host['host'], class: 'pd-env'.($n === (int)$current ? ' on' : void))
	}
	return tag('div', $out, class: 'pd-envs')
}

static picker($app, $pages){
	if (!$pages) return void
	$options = void
	foreach (static::grouped($pages) AS $group => $paths){
		$items = void
		foreach ($paths AS $i => $path) $items .= tag('option', esc($path), value: $i)
		$options .= tag('optgroup', $items, label: $group === slash ? en('Pages') : slash.$group)
	}
	$picker = tag('label', overview::icon('panel', 13, 'muted').select($options, class: 'pd-page'), class: 'pd-pick')
	$langs = static::langs($pages)
	if ($langs){
		$items = tag('option', en('Default'), value: void)
		foreach ($langs AS $lang) $items .= tag('option', esc(strtoupper($lang)), value: $lang)
		$picker .= tag('label', overview::icon('globe', 13, 'muted').select($items, class: 'pd-lang'), class: 'pd-pick pd-pick-lang')
	}
	return tag('div', $picker, class: 'pd-picker')
}

// Name and fleet numbers share one line: the preview underneath already names the domain.
static head($product, $meta){
	$face = $product['face']
	$host = (string)$face['host']
	$name = trim((string)($meta['home']['site'] ?? void)) ?: (trim((string)($meta['home']['title'] ?? void)) ?: $host)
	$stats = overview::statusCell((int)($face['code'] ?? 0), (int)($face['ms'] ?? 0))
	if ((int)$face['visitors']) $stats .= tag('a', overview::icon('eye', 12).tag('span', (string)(int)$face['visitors']), href: '/visitors/q='.rawurlencode($host), target: '_blank', class: 'pd-stat')
	if ((int)$face['errors']) $stats .= tag('a', overview::icon('alert', 12).tag('span', (string)(int)$face['errors']), href: '/errors/'.rawurlencode((string)$face['node']).slash.rawurlencode((string)$face['app']), class: 'pd-stat async pd-err')
	$stats .= tag('span', overview::icon('server', 12).tag('span', esc((string)$face['nodeLabel'])), class: 'pd-stat')
	return tag('div', tag('h2', esc($name), class: 'pd-name').tag('div', $stats, class: 'pd-ops'), class: 'pd-head')
}

static card($product, $meta = null){
	$app = (string)$product['app']
	$host = (string)$product['face']['host']
	$body = static::head($product, $meta)
	if ($meta){
		$home = (array)$meta['home']
		$body .= static::previewBox(['app' => $app, 'host' => $host, 'url' => 'https://'.$host.slash, 'env' => 0, 'i' => -1, 'lang' => void], $home)
	}
	else $body .= static::blank($app)
	$body .= static::envs($product)
	$body .= static::picker($app, (array)($meta['pages'] ?? []))
	if ($meta){
		$pages = (array)($meta['pages'] ?? [])
		$foot = tag('span', $pages ? en('%d pages', count($pages)) : en('no sitemap'), class: 'pd-age')
		$foot .= tag('span', time_human((int)($meta['fetched'] ?? time())).' '.en('old'), class: 'pd-age')
		$foot .= tag('button', overview::icon('refresh', 12), type: 'button', data_app: $app, title: en('Refresh preview'), class: 'pd-btn pd-load pd-refresh')
		$body .= tag('div', $foot, class: 'pd-foot')
	}
	return tag('article', $body, id: static::id($app), class: 'pd-card', data_app: $app, data_empty: $meta ? null : true)
}

static view {
	$products = static::products()
	if (!$products) return tag('div', tag('p', en('No published sites found in the fleet yet.'), class: 'pd-none'), class: 'pd-wrap')
	$cards = void
	$empty = 0
	foreach ($products AS $slug => $product){
		$meta = static::stored($slug)
		$meta === null && $empty++
		$cards .= static::card($product, $meta)
	}
	$bar = tag('span', en('%d products', count($products)), class: 'pd-count')
	if ($empty) $bar .= tag('button', en('Load %d previews', $empty), type: 'button', id: 'pd-all', class: 'pd-btn primary')
	$bar = tag('div', $bar, class: 'pd-bar')
	return tag('div', $bar.tag('section', $cards, class: 'pd-grid'), class: 'pd-wrap')
}

route both GET products {
	%app->active = 'product'
	main(static::view(), en('Products'))
}

route async GET product load $app {
	$product = static::products()[$app] ?? null
	if (!$product) return apply(error: en('Unknown product'))
	$data = static::fetch((string)$product['face']['host'])
	if (!$data) return apply(error: en('Could not reach %s', (string)$product['face']['host']))
	static::store($app, $data)
	return apply(outer: ['#'.static::id($app) => static::card($product, $data)])
}

// Serves a preview image from our own origin, so a strict img-src keeps holding. $app only selects a stored
// preview; the address that gets fetched comes from that file, never from the request.
route GET product image $app $env $i $lang= {
	if (!isset(static::products()[$app])) return false
	$bytes = static::shot($app, (int)$env, (int)$i, $lang ?? void)
	if ($bytes === null) return false
	%res->header('Cache-Control', 'private, max-age=86400')
	return output($bytes, type: (string)(@getimagesizefromstring($bytes)['mime'] ?? 'application/octet-stream'))
}

// The preview a card is showing: environment, page and language, each an index into what the fleet and the
// site itself published. Fetched live and never stored, so it cannot go stale.
route async GET product view $app $env $i $lang= {
	$view = static::resolve($app, $env, $i, $lang ?? void)
	if (!$view) return apply(error: en('Unknown page'))
	$html = static::GET($view['url'])
	if ($html === null) return apply(error: en('Could not reach %s', (string)$view['url']))
	return apply(outer: ['#'.static::previewId($app) => static::previewBox($view, static::meta($html, 'https://'.$view['host']))])
}

<script>
const pdView = card => {
	const env = card.querySelector('.pd-env.on')
	const page = card.querySelector('.pd-page')
	const lang = card.querySelector('.pd-lang')
	const parts = [card.dataset.app, env ? env.dataset.env : 0, page ? page.value : -1]
	if (lang && lang.value) parts.push(lang.value)
	app.get('product/view/' + parts.join('/'), false)
}

const pdBroken = img => img.replaceWith(Object.assign(document.createElement('div'), {className: 'pd-img pd-noimg'}))

on('click', '.pd-load', el => app.get('product/load/' + el.dataset.app, false))

on('click', '#pd-all', () => objects('.pd-card[data-empty] .pd-load').forEach(el => app.get('product/load/' + el.dataset.app, false)))

on('click', '.pd-env', el => {
	const card = el.closest('.pd-card')
	objects('.pd-env', card).forEach(pill => pill.classList.remove('on'))
	el.classList.add('on')
	pdView(card)
})

on('change', '.pd-page, .pd-lang', el => pdView(el.closest('.pd-card')))

// An og:image that no longer resolves leaves the placeholder instead of a broken picture. onExist covers the
// one that already failed before the listener was bound.
on('error', 'img.pd-img', el => pdBroken(el))
onExist('img.pd-img', img => img.complete && !img.naturalWidth && pdBroken(img))
</script>

<style>
.pd-bar {
	align-items: center
	display: flex
	gap: 10px
	justify-content: space-between
	margin-bottom: 12px
}
.pd-count {
	color: $muted
	font-size: 13px
}
.pd-grid {
	display: grid
	gap: 12px
	grid-template-columns: repeat(auto-fill, minmax(320px, 1fr))
}
.pd-card {
	background: $surface
	border: 1px solid $border
	border-radius: 14px
	display: flex
	flex-direction: column
	overflow: hidden
}
.pd-head {
	align-items: center
	display: flex
	gap: 10px
	justify-content: space-between
	padding: 8px 12px
}
.pd-name {
	color: $text
	flex: 1
	font-size: 14px
	font-weight: 600
	min-width: 0
	overflow: hidden
	text-overflow: ellipsis
	white-space: nowrap
}
.pd-preview {
	background: $bg
	border-block: 1px solid $border
}
.pd-link {
	color: inherit
	display: block
	text-decoration: none
}
.pd-link:hover .pd-title {
	color: $primary
}
.pd-img {
	aspect-ratio: 1.91 / 1
	display: block
	max-height: 190px
	object-fit: cover
	width: 100%
}
.pd-noimg {
	align-items: center
	color: $muted
	display: flex
	justify-content: center
}
.pd-body {
	display: flex
	flex-direction: column
	gap: 2px
	padding: 8px 12px
}
.pd-domain {
	color: $muted
	font-size: 10px
	letter-spacing: .6px
	line-height: 1.4
}
.pd-title {
	color: $text
	font-size: 14px
	font-weight: 600
	line-height: 1.35
	overflow: hidden
	text-overflow: ellipsis
	white-space: nowrap
}
.pd-descr {
	color: $muted
	display: -webkit-box
	-webkit-box-orient: vertical
	-webkit-line-clamp: 2
	font-size: 12px
	line-height: 1.4
	min-height: 2.8em
	overflow: hidden
}
.pd-blank .pd-body {
	align-items: flex-start
	gap: 8px
}
.pd-envs {
	display: flex
	gap: 4px
	overflow-x: auto
	padding: 8px 12px 0
	scrollbar-width: none
}
.pd-env {
	align-items: center
	background: $bg
	border: 1px solid $border
	border-radius: 999px
	color: $muted
	cursor: pointer
	display: flex
	flex-shrink: 0
	font-size: 10px
	gap: 4px
	letter-spacing: .4px
	padding: 3px 8px
	text-transform: uppercase
}
.pd-env:hover {
	color: $text
}
.pd-env.on {
	border-color: $primary
	color: $primary
}
.pd-picker {
	display: flex
	gap: 6px
	padding: 6px 12px 0
}
.pd-pick {
	align-items: center
	background: $bg
	border: 1px solid $border
