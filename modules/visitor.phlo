@ extends: model

view: $this->IP

# Visitor data via the fleet API (GET /api/visitors, HMAC): the own node (if localVisitors=1, directly
# without self-HTTP) + the peers with visitors=1 in [fleet]. Cached per request, merged. No remote MySQL.
static report {
	%req->visitorReport ??= static::fetchReport()
	return %req->visitorReport
}

static fetchReport {
	$merged = ['active' => 0, 'recent' => [], 'countries' => [], 'browsers' => [], 'referrers' => []]
	if (%creds->localVisitors ?? null){
		static::mergeReport($merged, fleet::visitorReport())
	}
	foreach ((fleet::peers() ?? []) AS $peer){
		if (!($peer->visitors ?? null)) continue
		$url = (string)($peer->url ?? void)
		$secret = (string)($peer->secret ?? void)
		if ($url === void || $secret === void) continue
		$time = (string)time()
		$headers = ['X-Fleet-Time: '.$time, 'X-Fleet-Sign: '.hash_hmac('sha256', $time, $secret)]
		try {
			static::mergeReport($merged, json_decode((string)HTTP($url.'/api/visitors', $headers), true))
		}
		catch (\Throwable $e){
			continue
		}
	}
	usort($merged['recent'], fn($a, $b) => ((int)($b['changed'] ?? 0)) <=> ((int)($a['changed'] ?? 0)))
	$merged['recent'] = array_slice($merged['recent'], 0, 200)
	return $merged
}

static mergeReport(&$merged, $r){
	if (!is_array($r)) return
	$merged['active'] += (int)($r['active'] ?? 0)
	$merged['recent'] = array_merge($merged['recent'], (array)($r['recent'] ?? []))
	foreach (['countries' => 'country', 'browsers' => 'browser', 'referrers' => 'referrer'] AS $agg => $key){
		foreach ((array)($r[$agg] ?? []) AS $row){
			$k = (string)($row[$key] ?? '')
			$merged[$agg][$k] = ($merged[$agg][$k] ?? 0) + (int)($row['count'] ?? 0)
		}
	}
}

static topPairs($keyed, $n){
	arsort($keyed)
	return array_slice($keyed, 0, $n, true)
}

static rowObject($row){
	$v = new static
	foreach ((array)$row AS $k => $val) $v->$k = $val
	return $v
}

static records(...$args){
	$rows = static::report()['recent'] ?? []
	# CMS pagination sends limit as the MySQL "offset,count" string; honour that as well as a plain count + offset arg.
	if (($limit = (string)($args['limit'] ?? '')) !== ''){
		$parts = explode(comma, $limit)
		$offset = count($parts) === 2 ? (int)$parts[0] : (int)($args['offset'] ?? 0)
		$count = (int)end($parts)
		if ($count > 0) $rows = array_slice($rows, $offset, $count)
	}
	$out = []
	foreach ($rows AS $i => $row) $out[$row['id'] ?? $i] = static::rowObject($row)
	return $out
}

static recordCount(...$args) => count(static::report()['recent'] ?? [])

static record(...$args){
	$id = (string)($args['id'] ?? void)
	foreach (static::report()['recent'] ?? [] AS $row) if ((string)($row['id'] ?? '') === $id) return static::rowObject($row)
	return null
}

static titleList = 'Visitors'
static titleRecord = 'Visitor'

static table = 'visitors'
static order = 'changed DESC'

static canView => (bool)(auth::user()?->isAdmin)
static canCreate = false
static canChange = false
static canDelete = false

static flag($cc) => $cc && strlen($cc) === 2 && ctype_alpha($cc) ? tag('span', mb_chr(127397 + ord(strtoupper($cc[0]))).mb_chr(127397 + ord(strtoupper($cc[1]))), class: 'flag') : void
static deviceIcon($device) => ['mobile' => '📱', 'tablet' => '📱', 'desktop' => '💻'][strtolower((string)$device)] ?? '🖥️'

prop kind => !$this->IP ? 'untracked' : (str_starts_with((string)$this->IP, '66.249.') || preg_match('/bot|spider|crawl|slurp/i', (string)$this->browser) ? 'bot' : 'real')
prop URL => tag('a', esc($this->host), href: "https://$this->host", title: esc("$this->host/$this->page"), target: '_blank')
prop duration => $this->active_seconds ? age_human((int)$this->active_seconds) : dash
prop pageList => $this->pages ? loop($this->pages, fn($p) => esc(($p['page'] ?? '') ?: slash).' ('.age_human((int)($p['active_seconds'] ?? 0)).')', '<br>') : dash
prop client {
	if ($this->kind === 'untracked' || (strlen((string)$this->browser) === 8 && ctype_xdigit((string)$this->browser))) return static::deviceIcon($this->device).space.tag('span', 'untracked', class: 'untracked')
	$os = str_starts_with((string)$this->os, 'Windows') ? 'Windows' : $this->os
	return static::deviceIcon($this->device).space.esc((string)$this->browser).($os ? ' ('.esc((string)$os).')' : void)
}
prop location => !$this->IP ? tag('span', 'untracked', class: 'untracked', title: 'No cookie consent') : ($this->country ? tag('a', static::flag($this->country).space.($this->city && $this->country ? "$this->city, $this->country" : ($this->country ?? dash)), href: "https://www.google.com/maps/@$this->lat,$this->lon,14z", target: 'map') : dash)

# Compact label for the recent-visitors widget; untracked visitors (no consent → no IP) show as
# 'untracked' instead of their anonymous browser hash / empty city/os fields.
static recentLabel($v){
	$head = tag('b', esc((string)($v['host'] ?? ''))).space.esc(strtoupper((string)($v['lang'] ?? '')))
	if (empty($v['IP'])) return $head.space.tag('span', 'untracked', class: 'untracked')
	return $head.space.trim(esc((string)($v['city'] ?? '')).space.esc((string)($v['browser'] ?? '')).space.esc((string)($v['os'] ?? '')))
}

static objWidgets {
	$rep = static::report()
	return [
		'Active Visitors' => obj (
			order: 1,
			type: 'gauge',
			data: (int)($rep['active'] ?? 0),
		),
		'Last 5 Visitors' => obj (
			order: 4,
			type: 'list',
			data: loop(array_slice($rep['recent'] ?? [], 0, 5), fn($v) => tag('a', static::recentLabel($v), href: '/visitor/'.($v['id'] ?? ''), class: 'async')." · ".tag('span', void, data_ts: (int)($v['changed'] ?? 0))),
		),
		'Top 5 Countries (30d)' => obj (
			order: 9,
			type: 'pie',
			data: static::topPairs($rep['countries'] ?? [], 5),
		),
		'Top 5 Browsers (30d)' => obj (
			order: 10,
			type: 'pie',
			data: static::topPairs($rep['browsers'] ?? [], 5),
		),
		'Top 8 Referrers (30d)' => obj (
			order: 11,
			type: 'list',
			data: loop(static::topPairs($rep['referrers'] ?? [], 8), fn($count, $ref) => tag('b', $count.'x').space.tag('a', href: preg_match('~^https?://~i', (string)$ref) ? $ref : (str_contains((string)$ref, '://') ? '#' : 'https://'.$ref), target: '_blank', inner: esc(preg_replace('/^https?:\/\/(www\.)?/', '', (string)$ref)))),
		),
	]
}

static schema => arr (
	id: field (
		type: 'text',
		title: 'ID',
		length: 20,
		create: false,
		change: false,
		list: false,
		record: false,
	),
	token: field (
		type: 'text',
		title: 'Token',
		length: 20,
		list: false,
		record: false,
	),
	host: field (
		type: 'text',
		title: 'Host',
		list: false,
		record: false,
		search: true,
		length: 24,
	),
	page: field (
		type: 'text',
		list: false,
		record: false,
		title: 'Page',
		search: true,
		length: 24,
	),
	lang: field (
		type: 'text',
		title: 'Language',
		length: 2,
		list: false,
	),
	URL: field (
		type: 'virtual',
	),
	kind: field (
		type: 'virtual',
		title: 'Type',
		list: true,
		label: fn($r) => tag('span', $r->kind, class: 'vkind '.$r->kind),
	),
	location: field (
		type: 'virtual',
		title: 'Location',
		list: true,
	),
	duration: field (
		type: 'virtual',
		title: 'Duration',
	),
	client: field (
		type: 'virtual',
		title: 'Client',
		list: true,
	),
	isp: field (
		type: 'virtual',
		title: 'Provider',
		label: fn($r) => $r->isp ?? dash,
	),
	IP: field (
		type: 'text',
		title: 'IP Address',
		length: 15,
		search: true,
	),
	browser: field (
		type: 'text',
		title: 'Browser',
		length: 18,
		list: false,
		search: true,
		record: false,
	),
	os: field (
		type: 'text',
		title: 'OS',
		length: 18,
		list: false,
		search: true,
		record: false,
	),
	device: field (
		type: 'text',
		title: 'Device',
		length: 12,
		list: false,
		record: false,
	),
	pages: field (
		type: 'virtual',
		title: 'Pages',
		list: false,
		record: true,
		label: fn($r) => $r->pageList,
	),
	state: field (
		type: 'select',
		title: 'Status',
		options: ['active', 'blurred', 'hidden'],
		list: false,
	),
	width: field (
		type: 'number',
		title: 'Width',
		list: false,
		record: false,
	),
	height: field (
		type: 'number',
		title: 'Height',
		list: false,
		record: false,
	),
	referrer: field (
		type: 'text',
		title: 'Referrer',
		length: 100,
		label: fn($r) => ($ref = $r->referrer) ? (str_starts_with($ref, 'search:') ? tag('span', esc(substr($ref, 7)), class: 'ref-search') : tag('a', href: preg_match('~^https?://~i', (string)$ref) ? $ref : (str_contains($ref, '://') ? '#' : 'https://'.$ref), target: '_blank', inner: esc(preg_replace('/^https?:\/\/(www\.)?/', '', $ref)))) : tag('span', 'direct', class: 'untracked'),
		search: true,
		list: true,
	),
	country: field (
		type: 'virtual',
		title: 'Country',
		label: fn($r) => $r->country ?? dash,
		list: false,
		record: false,
	),
	city: field (
		type: 'virtual',
		title: 'City',
		label: fn($r) => $r->city ?? dash,
		list: false,
		record: false,
	),
	created: field (
		type: 'datetime',
		title: 'Seen',
		list: false,
	),
	changed: field (
		type: 'datetime',
		title: 'Last active',
	),
)

<style>
@font-face {
	font-family: 'FlagEmoji'
	font-display: swap
	src: url('/flags.woff2') format('woff2')
}
.flag {
	font-family: 'FlagEmoji', system-ui, sans-serif
	margin-right: .15rem
}
.untracked {
	color: $muted
	font-style: italic
	opacity: .75
}
.ref-search {
	color: $primary
	font-weight: 600
}
.vkind {
	border-radius: 999px
	font-size: .72em
	font-weight: 600
	padding: .12rem .5rem
	text-transform: capitalize
}
.vkind.real {
	background: color-mix(in srgb, $success 22%, transparent)
	color: $success
}
.vkind.bot {
	background: color-mix(in srgb, $warn 22%, transparent)
	color: $warn
}
.vkind.untracked {
	background: color-mix(in srgb, $muted 25%, transparent)
	color: $muted
}
</style>
