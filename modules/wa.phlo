@ summary: WhatsApp publish proxy. Secret-gated send (POST) and read (GET) to the local phloWA engine(s). Cross-host endpoint for WhatsApp apps.
@ requires: HTTP

static sendActions => ['text', 'image', 'audio', 'document', 'location', 'poll', 'reaction', 'read', 'voice']

static readActions => ['status', 'qr', 'health']

static instances {
	$list = []
	foreach (glob(fleet::base().'/config/wa*.js') AS $f){
		if (preg_match("/\\(\\s*'([a-z0-9]+)'\\s*,\\s*(\\d+)\\s*,\\s*'([^']+)'/", (string)@file_get_contents($f), $m)) $list[$m[1]] = ['port' => (int)$m[2], 'secret' => $m[3]]
	}
	return $list
}

static status($port, $secret){
	try {
		$res = @json_decode(HTTP('http://127.0.0.1:'.$port.'/status', ['secret: '.$secret]), true)
		return is_array($res) ? (string)($res['status'] ?? 'unknown') : 'offline'
	}
	catch (\Throwable $e){
		return 'offline'
	}
}

route POST api wa $instance $action {
	$inst = static::instances()[$instance] ?? null
	if (!$inst) return error('Unknown instance', 404)
	if (!in_array($action, static::sendActions())) return error('Invalid action', 400)
	$secret = (string)($_SERVER['HTTP_SECRET'] ?? void)
	if ($secret === void || !hash_equals($inst['secret'], $secret)) return error('Unauthorized', 401)
	$body = (string)file_get_contents('php://input')
	return output((string)HTTP('http://127.0.0.1:'.$inst['port'].'/'.$action, ['secret: '.$inst['secret']], true, $body), type: 'application/json')
}

route GET api wa $instance $action {
	$inst = static::instances()[$instance] ?? null
	if (!$inst) return error('Unknown instance', 404)
	if (!in_array($action, static::readActions())) return error('Invalid action', 400)
	$secret = $_SERVER['HTTP_SECRET'] ?? void
	if ($secret === void || !hash_equals($inst['secret'], $secret)) return error('Unauthorized', 401)
	return output((string)HTTP('http://127.0.0.1:'.$inst['port'].'/'.$action, ['secret: '.$inst['secret']]), type: 'application/json')
}
