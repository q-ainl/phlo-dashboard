@ summary: WhatsApp UI. Overview of all engine instances across the whole fleet (from the fleet feed)

route both GET whatsapp {
	%app->active = 'whatsapp'
	main($this->grid, 'WhatsApp')
}

method grid {
	$out = void
	foreach (auth::servers() AS $node){
		$feed = fleet::cached($node) ?: []
		$instances = $feed['whatsapp'] ?? []
		if (!$instances) continue
		$cards = void
		foreach ($instances AS $inst){
			$st = (string)($inst['status'] ?? 'offline')
			$ready = $st === 'ready'
			$head = tag('div', tag('span', strtoupper((string)$inst['instance']), class: 'wa-name').tag('span', ':'.$inst['port'], class: 'wa-port'), class: 'wa-head')
			$badge = tag('div', $st, class: 'wa-state '.($ready ? 'ok' : (($inst['qr'] ?? null) ? 'qr' : 'down')))
			$meta = void
			if ($ready){
				$meta .= tag('div', overview::icon('clock', 13, 'muted').tag('span', age_human((int)($inst['uptime'] ?? 0))), class: 'wa-meta')
				$wh = (bool)($inst['webhook'] ?? false)
				$meta .= tag('div', overview::icon($wh ? 'check' : 'alert', 13, $wh ? 'emerald' : 'error').tag('span', $wh ? 'webhook ok' : 'no webhook'), class: 'wa-meta'.($wh ? void : ' bad'))
			}
			elseif ($inst['qr'] ?? null) $meta .= tag('div', overview::icon('refresh', 13, 'warn').tag('span', 'scan QR to link'), class: 'wa-meta')
			$host = $node === 'local' ? %req->host : (parse_url((string)(fleet::peers()?->$node?->url ?? void), PHP_URL_HOST) ?: $node)
			$send = tag('div', tag('code', $host.'/api/wa/'.$inst['instance']), class: 'wa-url', title: 'Send endpoint (POST + secret)')
			$cards .= tag('div', $head.$badge.$meta.$send, class: 'wa-card'.($ready ? ' on' : ''))
		}
		$head = tag('h2', overview::icon('server', 18, 'blue').tag('span', $feed['label'] ?? $node), class: 'wa-server')
		$out .= tag('section', $head.tag('div', $cards, class: 'wa-grid'), class: 'wa-block')
	}
	return $out ?: tag('p', 'No WhatsApp engines found.')
}

<style>
.wa-block {
	margin-bottom: 1.5rem
}
.wa-server {
	align-items: center
	color: $text
	display: flex
	font-size: 1.15rem
	gap: .5rem
	margin: 0 0 .75rem
}
.wa-grid {
	display: grid
	gap: 1rem
	grid-template-columns: repeat(auto-fill, minmax(200px, 1fr))
}
.wa-card {
	background: $surface
	border: 1px solid $border
	border-radius: 12px
	padding: 1.1rem
}
.wa-head {
	align-items: baseline
	display: flex
	justify-content: space-between
}
.wa-name {
	color: $text
	font-size: 1.1rem
	font-weight: 700
}
.wa-port {
	color: $muted
	font-family: monospace
	font-size: .8rem
}
.wa-state {
	border-radius: 999px
	display: inline-block
	font-size: .8rem
	font-weight: 600
	margin-top: .75rem
	padding: .2rem .7rem
	text-transform: capitalize
}
.wa-state.ok {
	background: color-mix(in srgb, $success 22%, transparent)
	color: $success
}
.wa-state.down {
	background: color-mix(in srgb, $error 22%, transparent)
	color: $error
}
.wa-state.qr {
	background: color-mix(in srgb, $warn 22%, transparent)
	color: $warn
}
.wa-meta {
	align-items: center
	color: $muted
	display: flex
	font-size: .8rem
	gap: .35rem
	margin-top: .5rem
}
.wa-meta.bad: color: $error
.wa-url {
	margin-top: .75rem
	overflow: hidden
}
.wa-url code {
	background: $bg
	border-radius: 5px
	color: $muted
	display: block
	font-size: .72rem
	overflow: hidden
	padding: .3rem .5rem
	text-overflow: ellipsis
	white-space: nowrap
}
</style>
