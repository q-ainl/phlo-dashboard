static icons => [
	'activity' => '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
	'server' => '<rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>',
	'cpu' => '<rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>',
	'harddrive' => '<line x1="22" x2="2" y1="12" y2="12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" x2="6.01" y1="16" y2="16"/><line x1="10" x2="10.01" y1="16" y2="16"/>',
	'clock' => '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
	'globe' => '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
	'alert' => '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
	'refresh' => '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
]

static icon($name, $size = 16, $class = void) => '<svg class="ic'.($class ? ' '.$class : void).'" width="'.$size.'" height="'.$size.'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'.(static::icons()[$name] ?? void).'</svg>'

static pct($used, $total) => $total > 0 ? min(100, (int)round($used / $total * 100)) : 0

static loadPct($m) => ($m->cpu_count ?? 0) > 0 ? min(100, (int)round(($m->load1 ?? 0) / $m->cpu_count * 100)) : 0

static bar($label, $pct, $ic, $variant, $detail){
	$level = $variant ?: ($pct > 85 ? 'high' : ($pct > 70 ? 'mid' : 'ok'))
	$right = ($detail ? tag('span', $detail, class: 'pb-detail') : void).tag('span', $pct.'%', class: 'pb-val')
	$top = tag('div', tag('span', static::icon($ic, 15, 'muted').tag('span', $label), class: 'pb-label').tag('span', $right, class: 'pb-right'), class: 'pb-top')
	$track = tag('div', tag('div', void, class: 'pb-fill', style: 'width:'.$pct.'%'), class: 'pb-track')
	return tag('div', $top.$track, class: 'pb '.$level)
}

static envState($code){
	$c = (int)$code
	if ($c === 0 || $c >= 500) return 'down'
	if ($c === 401 || $c === 403) return 'auth'
	if ($c >= 300 && $c < 400) return 'redir'
	if ($c >= 400) return 'warn'
	return 'up'
}

static metricCard($feed){
	$m = (object)($feed['metrics'] ?? [])
	$label = $feed['label'] ?? ($feed['server'] ?? '?')
	$online = $feed['ok'] ?? false
	$pill = tag('span', tag('span', void, class: 'sw-dot').tag('span', $online ? 'online' : 'offline'), class: 'sw-pill '.($online ? 'online' : 'offline'))
	$titles = tag('div', tag('span', $label, class: 'sw-name').tag('span', ($feed['server'] ?? void).' · Phlo '.($feed['phlo'] ?? '?'), class: 'sw-sub'), class: 'sw-titles')
	$head = tag('div', tag('div', static::icon('server', 18, 'blue').$titles, class: 'sw-id').$pill, class: 'sw-head')
	if (!$online) return tag('div', $head.tag('p', 'niet bereikbaar', class: 'sw-offline'), class: 'sw-card metric-card')
	$uptime = tag('div', static::icon('clock', 16, 'emerald').tag('div', tag('div', 'Uptime', class: 'sw-tile-label').tag('div', age_human($m->uptime_sec ?? 0), class: 'sw-tile-val')), class: 'sw-tile')
	$bars = static::bar('CPU Load', static::loadPct($m), 'cpu', void, ($m->load1 ?? 0).' / '.($m->cpu_count ?? 0).' cpu').static::bar('Geheugen', static::pct($m->mem_used ?? 0, $m->mem_total ?? 0), 'activity', void, size_human($m->mem_used ?? 0).' / '.size_human($m->mem_total ?? 0)).static::bar('Disk', static::pct($m->disk_used ?? 0, $m->disk_total ?? 0), 'harddrive', 'disk', size_human($m->disk_used ?? 0).' / '.size_human($m->disk_total ?? 0))
	return tag('div', $head.$uptime.tag('div', $bars, class: 'sw-bars'), class: 'sw-card metric-card')
}

static siteRow($a){
	$state = static::envState($a['code'] ?? 0)
	$code = (int)($a['code'] ?? 0)
	$status = tag('span', void, class: 'st-dot '.$state).tag('span', $code ?: 'down', class: 'ping-code')
	$name = tag('td', tag('a', $a['host'], href: 'https://'.$a['host'].'/', target: '_blank', class: 'site-link'), class: 'site-name')
	$env = tag('td', tag('span', strtoupper($a['env'] ?? ''), class: 'env-tag '.($a['env'] ?? '')), class: 'c')
	$st = tag('td', tag('span', $status, class: 'ping-main '.$state).tag('span', ($a['ms'] ?? 0).'ms', class: 'ping-ms'), class: 'c')
	return tag('tr', $name.$env.$st)
}

static sitesTable($apps){
	if (!$apps) return tag('p', 'geen sites', class: 'sw-offline')
	$head = tag('tr', tag('th', 'Applicatie').tag('th', 'Env', class: 'c').tag('th', 'Status', class: 'c'))
	$body = loop($apps, fn($a) => static::siteRow($a), void)
	return tag('div', tag('table', tag('thead', $head).tag('tbody', $body)), class: 'st-scroll')
}

static errorsBlock($errs){
	$total = 0
	foreach ($errs AS $x) $total += (int)($x['occurrences'] ?? 0)
	$h = tag('div', static::icon('alert', 14, $total ? 'error' : 'muted').tag('span', 'Errors ('.$total.')'), class: 'err-head')
	if (!$errs) return tag('div', $h.tag('div', 'geen fouten', class: 'err-none'), class: 'err-block')
	$rows = loop($errs, fn($x, $app) => tag('div', tag('span', $app, class: 'err-app').tag('span', (int)($x['unique'] ?? 0).'u / '.(int)($x['occurrences'] ?? 0).'occ', class: 'err-num'), class: 'err-row'), void)
	return tag('div', $h.tag('div', $rows, class: 'err-list'), class: 'err-block')
}

static serverPanel($feed){
	$left = static::metricCard($feed)
	if (!($feed['ok'] ?? false)) return tag('section', tag('div', $left, class: 'np-cols'), class: 'node-panel off')
	$right = tag('div', static::sitesTable($feed['apps'] ?? []).static::errorsBlock($feed['errors'] ?? []), class: 'np-right')
	return tag('section', tag('div', $left.$right, class: 'np-cols'), class: 'node-panel')
}

static panels {
	$out = void
	foreach (fleet::nodes() AS $node) $out .= static::serverPanel(fleet::cached($node) ?: ['label' => $node, 'ok' => false])
	return $out
}

route both GET overview {
	%app->active = 'overview'
	$local = fleet::cached('local')
	$polled = $local ? date('H:i:s', (int)($local['polled'] ?? $local['time'] ?? 0)) : 'n.v.t.'
	$titleBlock = tag('div', tag('h1', static::icon('activity', 26, 'blue').tag('span', 'Fleet Dashboard', class: 'grad'), class: 'dash-title').tag('p', 'Servers en applicaties over de hele fleet', class: 'dash-sub'))
	$update = tag('div', static::icon('refresh', 16, 'muted').tag('span', 'Laatste poll: '.tag('span', $polled, class: 'upd-time')), class: 'dash-update')
	$head = tag('header', $titleBlock.$update, class: 'dash-head')
	main(tag('div', $head.tag('div', static::panels(), class: 'node-list'), class: 'dash'), 'Overzicht')
}

<style>
.ic {
	display: inline-block
	flex-shrink: 0
	vertical-align: middle
}
.ic.blue: color: $primary
.ic.emerald: color: $success
.ic.muted: color: $muted
.ic.error: color: $error
.dash {
	display: flex
	flex-direction: column
	gap: 1.5rem
	margin: 0 auto
	max-width: 1500px
	padding: 1rem .25rem 2rem
}
.dash-head {
	align-items: center
	display: flex
	flex-wrap: wrap
	gap: 1rem
	justify-content: space-between
}
.dash-title {
	align-items: center
	display: flex
	font-size: 1.65rem
	font-weight: 800
	gap: .6rem
	margin: 0
}
.dash-title .grad {
	background: linear-gradient(90deg, $primary, $success)
	-webkit-background-clip: text
	background-clip: text
	color: transparent
}
.dash-sub {
	color: $muted
	margin: .35rem 0 0
}
.dash-update {
	align-items: center
	background: $surface
	border: 1px solid $border
	border-radius: 10px
	color: $muted
	display: flex
	font-size: .85rem
	gap: .5rem
	padding: .5rem .85rem
}
.upd-time {
	color: $text
	font-family: monospace
}
.node-list {
	display: flex
	flex-direction: column
	gap: 1.5rem
}
.np-cols {
	display: flex
	flex-direction: column
	gap: 1.25rem
}
@media(min-width:1000px){
	.np-cols: align-items: stretch
	.np-cols: flex-direction: row
	.metric-card: flex: 0 0 320px
}
.np-right {
	display: flex
	flex-direction: column
	flex: 1 1 0
	gap: 1rem
	min-width: 0
}
.sw-card {
	background: $surface
	border: 1px solid $border
	border-radius: 12px
	box-shadow: 0 10px 25px #0006
	display: flex
	flex-direction: column
	gap: 1.1rem
	padding: 1.25rem
}
.node-panel.off .metric-card: opacity: .6
.sw-head {
	align-items: flex-start
	display: flex
	gap: .5rem
	justify-content: space-between
}
.sw-id {
	align-items: center
	display: flex
	gap: .5rem
}
.sw-titles {
	display: flex
	flex-direction: column
	gap: .1rem
}
.sw-name {
	color: $text
	font-size: 1.15rem
	font-weight: 700
}
.sw-sub {
	color: $muted
	font-family: monospace
	font-size: .75rem
}
.sw-pill {
	align-items: center
	background: $bg
	border: 1px solid $border
	border-radius: 999px
	display: inline-flex
	font-size: .76rem
	gap: .4rem
	padding: .2rem .6rem
	white-space: nowrap
}
.sw-dot {
	animation: dashpulse 2s ease-in-out infinite
	border-radius: 50%
	height: 8px
	width: 8px
}
.sw-pill.online .sw-dot: background: $success
.sw-pill.offline .sw-dot: background: $error
@keyframes dashpulse {
	0%, 100%: opacity: 1
	50%: opacity: .35
}
.sw-tile {
	align-items: center
	background: $bg
	border: 1px solid $border
	border-radius: 10px
	display: flex
	gap: .75rem
	padding: .7rem
}
.sw-tile-label {
	color: $muted
	font-size: .75rem
}
.sw-tile-val {
	color: $text
	font-weight: 600
}
.sw-bars {
	display: flex
	flex-direction: column
	gap: .9rem
}
.sw-offline {
	color: $muted
	padding: .5rem 0
}
.pb-top {
	align-items: center
	color: $muted
	display: flex
	font-size: .82rem
	justify-content: space-between
	margin-bottom: .35rem
}
.pb-label {
	align-items: center
	display: flex
	gap: .4rem
}
.pb-right {
	align-items: baseline
	display: flex
	gap: .5rem
}
.pb-detail {
	color: $muted
	font-family: monospace
	font-size: .76em
}
.pb-val {
	color: $text
	font-weight: 600
}
.pb-track {
	background: color-mix(in srgb, $surface 75%, $text)
	border-radius: 999px
	height: 7px
	overflow: hidden
}
.pb-fill {
	background: $primary
	border-radius: 999px
	height: 100%
	transition: width .5s ease-in-out
}
.pb.mid .pb-fill: background: $warn
.pb.high .pb-fill: background: $error
.pb.disk .pb-fill: background: #a855f7
.st-scroll {
	background: $surface
	border: 1px solid $border
	border-radius: 12px
	box-shadow: 0 10px 25px #0006
	max-height: 420px
	overflow: auto
}
.st-scroll table {
	border-collapse: collapse
	width: 100%
}
.st-scroll th {
	background: color-mix(in srgb, $surface 92%, $text)
	color: $muted
	font-size: .7rem
	font-weight: 500
	letter-spacing: .05em
	padding: .7rem 1rem
	position: sticky
	text-align: left
	text-transform: uppercase
	top: 0
}
.st-scroll th.c: text-align: center
.st-scroll td {
	border-top: 1px solid color-mix(in srgb, $border 60%, transparent)
	padding: .55rem 1rem
	vertical-align: middle
}
.st-scroll td.c: text-align: center
.st-scroll tbody tr:hover: background: color-mix(in srgb, $surface 88%, $text)
.site-link {
	color: $text
	font-weight: 600
	text-decoration: none
	white-space: nowrap
}
.site-link:hover: color: $primary
.env-tag {
	border-radius: 6px
	font-size: .66rem
	font-weight: 700
	padding: .1rem .4rem
}
.env-tag.prod {
	background: color-mix(in srgb, $success 18%, transparent)
	color: $success
}
.env-tag.stage {
	background: color-mix(in srgb, $warn 18%, transparent)
	color: $warn
}
.env-tag.dev {
	background: color-mix(in srgb, $primary 18%, transparent)
	color: $primary
}
.ping-main {
	align-items: center
	display: inline-flex
	font-family: monospace
	font-size: .82rem
	font-weight: 600
	gap: .3rem
}
.ping-main.up: color: $success
.ping-main.auth: color: $primary
.ping-main.redir: color: $muted
.ping-main.warn: color: $warn
.ping-main.down: color: $error
.st-dot {
	border-radius: 50%
	display: inline-block
	flex-shrink: 0
	height: 8px
	width: 8px
}
.st-dot.up: background: $success
.st-dot.auth: background: $primary
.st-dot.redir: background: $muted
.st-dot.warn: background: $warn
.st-dot.down: background: $error
.ping-ms {
	color: $muted
	font-family: monospace
	font-size: .66rem
	margin-left: .4rem
}
.err-block {
	background: $surface
	border: 1px solid $border
	border-radius: 12px
	display: flex
	flex-direction: column
	gap: .5rem
	padding: 1rem 1.25rem
}
.err-head {
	align-items: center
	color: $muted
	display: flex
	font-size: .8rem
	gap: .4rem
}
.err-list {
	display: flex
	flex-direction: column
	gap: .3rem
	max-height: 130px
	overflow-y: auto
}
.err-row {
	display: flex
	font-size: .82rem
	justify-content: space-between
}
.err-app: color: $text
.err-num {
	color: $error
	font-family: monospace
	white-space: nowrap
}
.err-none {
	color: $success
	font-size: .82rem
}
</style>
