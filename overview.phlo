static icons => [
	'activity' => '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
	'server' => '<rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>',
	'cpu' => '<rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>',
	'harddrive' => '<line x1="22" x2="2" y1="12" y2="12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" x2="6.01" y1="16" y2="16"/><line x1="10" x2="10.01" y1="16" y2="16"/>',
	'clock' => '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
	'globe' => '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
	'alert' => '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
	'refresh' => '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
]

static icon($name, $size = 16, $class = void) => '<svg class="ic'.($class ? ' '.$class : void).'" width="'.$size.'" height="'.$size.'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'.(static::icons()[$name] ?? void).'</svg>'

static pct($used, $total) => $total > 0 ? min(100, (int)round($used / $total * 100)) : 0

static loadPct($m) => ($m->cpu_count ?? 0) > 0 ? min(100, (int)round(($m->load1 ?? 0) / $m->cpu_count * 100)) : 0

static bar($label, $pct, $ic, $variant, $detail){
	$level = $variant ?: ($pct > 85 ? 'high' : ($pct > 70 ? 'mid' : 'ok'))
	$right = ($detail ? tag('span', $detail, class: 'pb-detail') : void).tag('span', $pct.'%', class: 'pb-val')
	$top = tag('div', tag('span', static::icon($ic, 15, 'muted').tag('span', $label), class: 'pb-label').tag('span', $right, class: 'pb-right'), class: 'pb-top')
	$track = tag('div', tag('div', void, class: 'pb-fill', style: 'width:'.$pct.'%'), class: 'pb-track')
	return tag('div', $top.$track, class: 'pb '.$level)
}

static envChips($apps){
	$env = []
	foreach ($apps AS $a) $env[$a['env']] = ($env[$a['env']] ?? 0) + 1
	$chips = void
	foreach (['prod', 'stage', 'dev'] AS $e) if ($env[$e] ?? 0) $chips .= tag('span', strtoupper($e).' '.$env[$e], class: 'np-env '.$e)
	return $chips
}

static errRows($errs){
	if (!$errs) return tag('div', 'geen fouten', class: 'np-err-none')
	return loop($errs, fn($x, $app) => tag('div', tag('span', $app, class: 'np-err-app').tag('span', (int)($x['unique'] ?? 0).'u / '.(int)($x['occurrences'] ?? 0).'occ', class: 'np-err-num'), class: 'np-err-row'), void)
}

static serverPanel($feed){
	$label = $feed['label'] ?? ($feed['server'] ?? '?')
	if (!($feed['ok'] ?? false)){
		$head = tag('div', tag('div', static::icon('server', 18, 'muted').tag('span', $label, class: 'np-label'), class: 'np-name').tag('span', tag('span', void, class: 'sw-dot').tag('span', 'offline'), class: 'sw-pill offline'), class: 'np-head')
		return tag('section', $head.tag('p', 'niet bereikbaar', class: 'np-offline'), class: 'sw-card node-panel off')
	}
	$m = (object)($feed['metrics'] ?? [])
	$apps = $feed['apps'] ?? []
	$errs = $feed['errors'] ?? []
	$age = (int)($feed['age'] ?? 0)
	$errTotal = 0
	foreach ($errs AS $x) $errTotal += (int)($x['occurrences'] ?? 0)
	$pill = tag('span', tag('span', void, class: 'sw-dot').tag('span', 'online'), class: 'sw-pill online')
	$name = tag('div', static::icon('server', 18, 'blue').tag('div', tag('span', $label, class: 'np-label').tag('span', ($feed['server'] ?? void).' · Phlo '.($feed['phlo'] ?? '?'), class: 'np-sub'), class: 'np-titles'), class: 'np-name')
	$head = tag('div', $name.$pill, class: 'np-head')
	$bars = static::bar('CPU', static::loadPct($m), 'cpu', void, ($m->load1 ?? 0).' / '.($m->cpu_count ?? 0).' cpu').static::bar('Geheugen', static::pct($m->mem_used ?? 0, $m->mem_total ?? 0), 'activity', void, size_human($m->mem_used ?? 0).' / '.size_human($m->mem_total ?? 0)).static::bar('Disk', static::pct($m->disk_used ?? 0, $m->disk_total ?? 0), 'harddrive', 'disk', size_human($m->disk_used ?? 0).' / '.size_human($m->disk_total ?? 0))
	$uptime = tag('div', static::icon('clock', 14, 'emerald').tag('span', age_human($m->uptime_sec ?? 0).' uptime', class: 'np-up-val'), class: 'np-up')
	$appSec = tag('div', tag('div', tag('span', static::icon('globe', 14, 'muted').tag('span', count($apps).' hosts'), class: 'np-sec-l').tag('span', static::envChips($apps), class: 'np-chips'), class: 'np-sec-h'), class: 'np-apps')
	$errSec = tag('div', tag('div', static::icon('alert', 13, $errTotal ? 'error' : 'muted').tag('span', 'Errors ('.$errTotal.')'), class: 'np-sec-h np-err-h').tag('div', static::errRows($errs), class: 'np-err-list'), class: 'np-errs')
	return tag('section', tag('div', $head.$uptime, class: 'np-top').tag('div', $bars, class: 'sw-bars').$appSec.$errSec, class: 'sw-card node-panel')
}

static panels {
	$out = void
	foreach (fleet::nodes() AS $node) $out .= static::serverPanel(fleet::cached($node) ?: ['label' => $node, 'ok' => false])
	return $out
}

route both GET overview {
	%app->active = 'overview'
	$local = fleet::cached('local')
	$polled = $local ? date('H:i:s', (int)($local['polled'] ?? $local['time'] ?? 0)) : 'n.v.t.'
	$titleBlock = tag('div', tag('h1', static::icon('activity', 26, 'blue').tag('span', 'Fleet Dashboard', class: 'grad'), class: 'dash-title').tag('p', 'Servers en applicaties over de hele fleet', class: 'dash-sub'))
	$update = tag('div', static::icon('refresh', 16, 'muted').tag('span', 'Laatste poll: '.tag('span', $polled, class: 'upd-time')), class: 'dash-update')
	$head = tag('header', $titleBlock.$update, class: 'dash-head')
	main(tag('div', $head.tag('div', static::panels(), class: 'node-grid'), class: 'dash'), 'Overzicht')
}

<style>
.ic {
	display: inline-block
	flex-shrink: 0
	vertical-align: middle
}
.ic.blue: color: $primary
.ic.emerald: color: $success
.ic.muted: color: $muted
.ic.error: color: $error
.dash {
	display: flex
	flex-direction: column
	gap: 1.5rem
	margin: 0 auto
	max-width: 1500px
	padding: 1rem .25rem 2rem
}
.dash-head {
	align-items: center
	display: flex
	flex-wrap: wrap
	gap: 1rem
	justify-content: space-between
}
.dash-title {
	align-items: center
	display: flex
	font-size: 1.65rem
	font-weight: 800
	gap: .6rem
	margin: 0
}
.dash-title .grad {
	background: linear-gradient(90deg, $primary, $success)
	-webkit-background-clip: text
	background-clip: text
	color: transparent
}
.dash-sub {
	color: $muted
	margin: .35rem 0 0
}
.dash-update {
	align-items: center
	background: $surface
	border: 1px solid $border
	border-radius: 10px
	color: $muted
	display: flex
	font-size: .85rem
	gap: .5rem
	padding: .5rem .85rem
}
.upd-time {
	color: $text
	font-family: monospace
}
.node-grid {
	display: grid
	gap: 1.25rem
	grid-template-columns: repeat(auto-fill, minmax(340px, 1fr))
}
.sw-card {
	background: $surface
	border: 1px solid $border
	border-radius: 12px
	box-shadow: 0 10px 25px #0006
	display: flex
	flex-direction: column
	gap: 1rem
	padding: 1.25rem
}
.node-panel.off: opacity: .55
.np-top {
	align-items: flex-start
	display: flex
	justify-content: space-between
}
.np-head {
	align-items: center
	display: flex
	gap: .5rem
}
.np-name {
	align-items: center
	color: $text
	display: flex
	gap: .5rem
}
.np-titles {
	display: flex
	flex-direction: column
	gap: .1rem
}
.np-label {
	font-size: 1.15rem
	font-weight: 700
}
.np-sub {
	color: $muted
	font-family: monospace
	font-size: .75rem
}
.np-up {
	align-items: center
	color: $muted
	display: flex
	font-size: .78rem
	gap: .35rem
	white-space: nowrap
}
.np-up-val: color: $text
.sw-pill {
	align-items: center
	background: $bg
	border: 1px solid $border
	border-radius: 999px
	display: inline-flex
	font-size: .78rem
	gap: .45rem
	padding: .2rem .6rem
}
.sw-dot {
	animation: dashpulse 2s ease-in-out infinite
	border-radius: 50%
	height: 8px
	width: 8px
}
.sw-pill.online .sw-dot: background: $success
.sw-pill.offline .sw-dot: background: $error
@keyframes dashpulse {
	0%, 100%: opacity: 1
	50%: opacity: .35
}
.sw-bars {
	display: flex
	flex-direction: column
	gap: .9rem
}
.pb-top {
	align-items: center
	color: $muted
	display: flex
	font-size: .82rem
	justify-content: space-between
	margin-bottom: .35rem
}
.pb-label {
	align-items: center
	display: flex
	gap: .4rem
}
.pb-right {
	align-items: baseline
	display: flex
	gap: .5rem
}
.pb-detail {
	color: $muted
	font-family: monospace
	font-size: .76em
}
.pb-val {
	color: $text
	font-weight: 600
}
.pb-track {
	background: color-mix(in srgb, $surface 75%, $text)
	border-radius: 999px
	height: 7px
	overflow: hidden
}
.pb-fill {
	background: $primary
	border-radius: 999px
	height: 100%
	transition: width .5s ease-in-out
}
.pb.mid .pb-fill: background: $warn
.pb.high .pb-fill: background: $error
.pb.disk .pb-fill: background: #a855f7
.np-sec-h {
	align-items: center
	color: $muted
	display: flex
	font-size: .78rem
	gap: .5rem
	justify-content: space-between
}
.np-sec-l {
	align-items: center
	display: flex
	gap: .4rem
}
.np-chips {
	display: flex
	flex-wrap: wrap
	gap: .35rem
}
.np-env {
	border-radius: 6px
	font-size: .7rem
	font-weight: 600
	padding: .1rem .45rem
}
.np-env.prod {
	background: color-mix(in srgb, $success 20%, transparent)
	color: $success
}
.np-env.stage {
	background: color-mix(in srgb, $warn 20%, transparent)
	color: $warn
}
.np-env.dev {
	background: color-mix(in srgb, $primary 20%, transparent)
	color: $primary
}
.np-apps {
	border-top: 1px solid color-mix(in srgb, $border 60%, transparent)
	padding-top: .85rem
}
.np-errs {
	border-top: 1px solid color-mix(in srgb, $border 60%, transparent)
	display: flex
	flex-direction: column
	gap: .4rem
	padding-top: .85rem
}
.np-err-list {
	display: flex
	flex-direction: column
	gap: .25rem
	max-height: 140px
	overflow-y: auto
}
.np-err-row {
	display: flex
	font-size: .8rem
	justify-content: space-between
}
.np-err-app: color: $text
.np-err-num {
	color: $error
	font-family: monospace
	white-space: nowrap
}
.np-err-none {
	color: $success
	font-size: .8rem
}
.np-offline {
	color: $muted
	padding: 1rem 0
}
</style>
