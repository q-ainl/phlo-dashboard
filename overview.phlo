static groupApps($feedApps){
	$g = []
	$best = []
	foreach ($feedApps AS $a){
		$name = (string)($a['app'] ?? '')
		$env = (string)($a['env'] ?? 'prod')
		$host = (string)($a['host'] ?? '')
		$code = (int)($a['code'] ?? 0)
		if (!isset($g[$name])) $g[$name] = ['name' => $name, 'dev' => null, 'stage' => null, 'prod' => null]
		$key = $name.'|'.$env
		$redirCur = isset($best[$key]) && $best[$key] >= 300 && $best[$key] < 400
		$redirNew = $code >= 300 && $code < 400
		if (($g[$name][$env] ?? null) === null || ($redirCur && !$redirNew)){
			$g[$name][$env] = $host
			$best[$key] = $code
		}
	}
	return array_values($g)
}

static statusMap($feedApps){
	$s = []
	foreach ($feedApps AS $a) $s[$a['host']] = obj(code: (int)($a['code'] ?? 0), authed: in_array((int)($a['code'] ?? 0), [401, 403]), time_ms: (int)($a['ms'] ?? 0))
	return $s
}

static icons => [
	'activity' => '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
	'server' => '<rect width="20" height="8" x="2" y="2" rx="2"/><rect width="20" height="8" x="2" y="14" rx="2"/><line x1="6" x2="6.01" y1="6" y2="6"/><line x1="6" x2="6.01" y1="18" y2="18"/>',
	'cpu' => '<rect width="16" height="16" x="4" y="4" rx="2"/><rect width="6" height="6" x="9" y="9" rx="1"/><path d="M15 2v2"/><path d="M15 20v2"/><path d="M2 15h2"/><path d="M2 9h2"/><path d="M20 15h2"/><path d="M20 9h2"/><path d="M9 2v2"/><path d="M9 20v2"/>',
	'harddrive' => '<line x1="22" x2="2" y1="12" y2="12"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><line x1="6" x2="6.01" y1="16" y2="16"/><line x1="10" x2="10.01" y1="16" y2="16"/>',
	'clock' => '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
	'globe' => '<circle cx="12" cy="12" r="10"/><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"/><path d="M2 12h20"/>',
	'users' => '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
	'check' => '<circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/>',
	'x' => '<circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/>',
	'alert' => '<path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
	'lock' => '<rect width="18" height="11" x="3" y="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>',
	'refresh' => '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
]

static icon($name, $size = 16, $class = void) => '<svg class="ic'.($class ? ' '.$class : void).'" width="'.$size.'" height="'.$size.'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'.(static::icons()[$name] ?? void).'</svg>'

static pct($used, $total) => $total > 0 ? min(100, (int)round($used / $total * 100)) : 0

static loadPct($m) => ($m->cpu_count ?? 0) > 0 ? min(100, (int)round(($m->load1 ?? 0) / $m->cpu_count * 100)) : 0

static bar($label, $pct, $ic, $variant, $detail){
	$level = $variant ?: ($pct > 85 ? 'high' : ($pct > 70 ? 'mid' : 'ok'))
	$right = ($detail ? tag('span', $detail, class: 'pb-detail') : void).tag('span', $pct.'%', class: 'pb-val')
	$top = tag('div', tag('span', static::icon($ic, 15, 'muted').tag('span', $label), class: 'pb-label').tag('span', $right, class: 'pb-right'), class: 'pb-top')
	$track = tag('div', tag('div', void, class: 'pb-fill', style: 'width:'.$pct.'%'), class: 'pb-track')
	return tag('div', $top.$track, class: 'pb '.$level)
}

static actionBtn($node, $command, $label) => tag('button', $label, type: 'button', data_post: '/manage/'.$node.'/'.$command, data_confirm: $label.' op '.$node.'?', class: 'mg-btn')

static srvStat($ic, $val, $cls = void) => tag('span', static::icon($ic, 14).tag('span', $val), class: 'srv-stat'.($cls ? ' '.$cls : void))

static srvDots($feed){
	$apps = $feed['apps'] ?? []
	if (!$apps) return tag('div', 'geen sites', class: 'srv-muted')
	return tag('div', loop($apps, fn($a) => tag('a', void, href: 'https://'.$a['host'].'/', target: '_blank', title: $a['host'].' - '.((int)($a['code'] ?? 0) ?: 'down'), class: 'sdot '.static::envState($a['code'] ?? 0)), void), class: 'sdots')
}

static srvCounts($feed){
	$c = ['up' => 0, 'auth' => 0, 'warn' => 0, 'down' => 0]
	foreach (($feed['apps'] ?? []) AS $a) $c[static::envState($a['code'] ?? 0)]++
	$labels = ['up' => 'up', 'auth' => 'auth', 'warn' => 'warn', 'down' => 'down']
	$parts = void
	foreach ($labels AS $k => $lbl) if ($c[$k]) $parts .= tag('span', tag('span', void, class: 'st-dot '.$k).$c[$k].' '.$lbl, class: 'scount '.$k)
	return tag('div', $parts, class: 'scounts')
}

static srvTopErrors($feed){
	$errs = $feed['errors'] ?? []
	if (!$errs) return tag('div', static::icon('check', 14, 'emerald').tag('span', 'geen fouten'), class: 'serr-none')
	uasort($errs, fn($a, $b) => ($b['occurrences'] ?? 0) <=> ($a['occurrences'] ?? 0))
	return tag('div', loop(array_slice($errs, 0, 5, true), fn($x, $app) => tag('div', tag('span', $app, class: 'serr-app').tag('span', number_format((int)($x['occurrences'] ?? 0), 0, ',', '.'), class: 'serr-n'), class: 'serr-row'), void), class: 'serr-list')
}

static envState($code){
	$c = (int)$code
	if ($c === 0 || $c >= 500) return 'down'
	if ($c === 401 || $c === 403) return 'auth'
	if ($c >= 400) return 'warn'
	return 'up'
}

static envChip($label, $host, $status){
	$st = $host ? ($status[$host] ?? null) : null
	if (!$st) return tag('div', tag('span', $label, class: 'ping-label').tag('span', dash, class: 'ping-main empty'), class: 'ping')
	$state = static::envState($st->code)
	$lock = $st->authed ? static::icon('lock', 11, 'lock') : void
	$main = tag('span', void, class: 'st-dot '.$state).tag('span', (int)$st->code ?: 'down', class: 'ping-code').$lock
	$inner = tag('span', $label, class: 'ping-label').tag('span', $main, class: 'ping-main '.$state).tag('span', $st->time_ms.'ms', class: 'ping-ms')
	return tag('a', $inner, href: 'https://'.$host.'/', target: '_blank', class: 'ping', title: 'Open '.$host)
}

static appRow($app, $status, $visitors, $node, $errors, $canManage){
	$primary = $app['prod'] ?? $app['stage'] ?? $app['dev'] ?? ''
	$vis = (int)($visitors[$primary] ?? 0)
	$down = 0
	foreach (['dev', 'stage', 'prod'] AS $e) if (($app[$e] ?? null) && ($s = $status[$app[$e]] ?? null) && static::envState($s->code) === 'down') $down++
	$errOcc = (int)($errors[$app['name']]['occurrences'] ?? 0)
	$icon = ($down || $errOcc) ? static::icon('x', 18, 'error') : static::icon('check', 18, 'emerald')
	$name = tag('td', tag('a', $icon.tag('span', $app['name'], class: 'app-label'), href: 'https://'.$primary.'/', target: '_blank', class: 'app-link'), class: 'app-name')
	$v = tag('td', tag('span', static::icon('users', 15, 'blue').tag('span', $vis, class: 'vis-num'), class: 'vis'), class: 'c')
	$box = tag('div', static::envChip('DEV', $app['dev'], $status).tag('div', void, class: 'ping-div').static::envChip('STAGE', $app['stage'], $status).tag('div', void, class: 'ping-div').static::envChip('PROD', $app['prod'], $status), class: 'ping-box')
	$reset = $canManage && $errOcc ? tag('button', '✕', type: 'button', data_post: '/manage/'.$node.'/errors-reset/'.$app['name'], data_confirm: 'Errors van '.$app['name'].' wissen?', title: 'Reset errors', class: 'err-reset') : void
	$errCell = tag('td', $errOcc ? tag('span', static::icon('alert', 13).tag('span', $errOcc), class: 'err-badge').$reset : tag('span', '0', class: 'err-zero'), class: 'c')
	return tag('tr', $name.$v.tag('td', $box, class: 'c').$errCell)
}

static appTable($apps, $status, $visitors, $node, $errors, $canManage){
	$head = tag('tr', tag('th', 'Applicatie').tag('th', 'Bezoekers', class: 'c').tag('th', 'Dev / Stage / Prod', class: 'c').tag('th', 'Errors', class: 'c'))
	$body = loop($apps, fn($app) => static::appRow($app, $status, $visitors, $node, $errors, $canManage), void)
	$tbl = tag('table', tag('thead', $head).tag('tbody', $body))
	$badge = tag('span', count($apps).' actief', class: 'st-badge')
	$h = tag('div', tag('h2', static::icon('globe', 20, 'blue').tag('span', 'Gemonitorde sites'), class: 'st-title').$badge, class: 'st-head')
	return tag('section', $h.tag('div', $tbl, class: 'st-scroll'), class: 'sw-card st-card')
}

static serverHead($label, $sub, $ok, $extra = void){
	$pill = tag('span', tag('span', void, class: 'sw-dot').tag('span', $ok ? 'online' : 'offline'), class: 'sw-pill '.($ok ? 'online' : 'offline'))
	$titles = tag('div', tag('span', $label, class: 'sw-name').tag('span', $sub, class: 'sw-sub'), class: 'sw-titles')
	$left = tag('div', tag('span', void, class: 'srv-chev').static::icon('server', 18, 'blue').$titles, class: 'srv-id')
	return tag('div', $left.tag('div', $extra.$pill, class: 'srv-right'), class: 'srv-head')
}

static serverBlock($node){
	$feed = fleet::cached($node) ?: ['label' => $node, 'ok' => false]
	$label = $feed['label'] ?? $node
	$ok = $feed['ok'] ?? false
	if (!$ok) return tag('div', static::serverHead($label, 'niet bereikbaar', false), class: 'srv-card off')
	$m = (object)($feed['metrics'] ?? [])
	$apps = $feed['apps'] ?? []
	$canManage = in_array($feed['mode'] ?? '', ['self', 'pull'])
	$errTotal = 0
	foreach (($feed['errors'] ?? []) AS $x) $errTotal += (int)($x['occurrences'] ?? 0)
	$vis = (int)array_sum($feed['visitors'] ?? [])
	$extra = static::srvStat('clock', age_human($m->uptime_sec ?? 0)).static::srvStat('users', number_format($vis, 0, ',', '.'))
	$head = static::serverHead($label, ($feed['server'] ?? '?').' · Phlo '.($feed['phlo'] ?? '?'), true, $extra)
	$bars = tag('div', static::bar('CPU', static::loadPct($m), 'cpu', void, ($m->load1 ?? 0).' / '.($m->cpu_count ?? 0).' cpu').static::bar('Geheugen', static::pct($m->mem_used ?? 0, $m->mem_total ?? 0), 'activity', void, size_human($m->mem_used ?? 0).' / '.size_human($m->mem_total ?? 0)).static::bar('Disk', static::pct($m->disk_used ?? 0, $m->disk_total ?? 0), 'harddrive', 'disk', size_human($m->disk_used ?? 0).' / '.size_human($m->disk_total ?? 0)), class: 'sw-bars')
	$colRes = tag('div', tag('div', 'Resources', class: 'srv-coltitle').$bars, class: 'srv-col')
	$colSites = tag('div', tag('div', count($apps).' sites', class: 'srv-coltitle').static::srvDots($feed).static::srvCounts($feed), class: 'srv-col')
	$colErr = tag('div', tag('div', $errTotal.' errors', class: 'srv-coltitle'.($errTotal ? ' bad' : void)).static::srvTopErrors($feed), class: 'srv-col')
	$summary = tag('summary', $head.tag('div', $colRes.$colSites.$colErr, class: 'srv-grid'), class: 'srv-sum')
	$footer = $canManage ? tag('div', static::actionBtn($node, 'rebuild', 'Rebuild').static::actionBtn($node, 'ws-restart', 'WS herstart').static::actionBtn($node, 'errors-reset', 'Errors wissen'), class: 'mg-actions') : void
	$table = static::appTable(static::groupApps($apps), static::statusMap($apps), $feed['visitors'] ?? [], $node, $feed['errors'] ?? [], $canManage)
	return tag('details', $summary.tag('div', $table.$footer, class: 'srv-body'), class: 'srv-card')
}

route both GET overview {
	%app->active = 'overview'
	$blocks = loop(fleet::nodes(), fn($node) => static::serverBlock($node), void)
	$local = fleet::cached('local')
	$polled = $local ? date('H:i:s', (int)($local['polled'] ?? $local['time'] ?? 0)) : '-'
	$titleBlock = tag('div', tag('h1', static::icon('activity', 26, 'blue').tag('span', 'Fleet Dashboard', class: 'grad'), class: 'dash-title').tag('p', 'Real-time monitoring van alle servers', class: 'dash-sub'))
	$update = tag('div', static::icon('refresh', 16, 'muted').tag('span', 'Laatste poll: '.tag('span', $polled, class: 'upd-time')), class: 'dash-update')
	$head = tag('header', $titleBlock.$update, class: 'dash-head')
	main(tag('div', $head.$blocks, class: 'dash'), 'Overzicht')
}

<style>
.ic {
	display: inline-block
	flex-shrink: 0
	vertical-align: middle
}
.ic.blue: color: $primary
.ic.emerald: color: $success
.ic.muted: color: $muted
.ic.error: color: $error
.ic.purple: color: #a855f7
.ic.lock: color: $muted
.dash {
	display: flex
	flex-direction: column
	gap: 1.5rem
	margin: 0 auto
	max-width: 1400px
	padding: 1rem .25rem 2rem
}
.dash-head {
	align-items: center
	display: flex
	flex-wrap: wrap
	gap: 1rem
	justify-content: space-between
}
.dash-title {
	align-items: center
	display: flex
	font-size: 1.65rem
	font-weight: 800
	gap: .6rem
	margin: 0
}
.dash-title .grad {
	background: linear-gradient(90deg, $primary, $success)
	-webkit-background-clip: text
	background-clip: text
	color: transparent
}
.dash-sub {
	color: $muted
	margin: .35rem 0 0
}
.dash-update {
	align-items: center
	background: $surface
	border: 1px solid $border
	border-radius: 10px
	color: $muted
	display: flex
	font-size: .85rem
	gap: .5rem
	padding: .5rem .85rem
}
.upd-time {
	color: $text
	font-family: monospace
}
.sw-card {
	background: $surface
	border: 1px solid $border
	border-radius: 12px
	box-shadow: 0 10px 25px #0006
	display: flex
	flex-direction: column
	gap: 1.25rem
	padding: 1.25rem
}
.sw-titles {
	display: flex
	flex-direction: column
	gap: .15rem
}
.sw-name {
	align-items: center
	color: $text
	display: flex
	font-size: 1.2rem
	font-weight: 700
	gap: .5rem
	margin: 0
}
.sw-name .ic: color: $primary
.sw-sub {
	color: $muted
	font-family: monospace
	font-size: .8rem
}
.sw-pill {
	align-items: center
	background: $bg
	border: 1px solid $border
	border-radius: 999px
	display: inline-flex
	font-size: .8rem
	gap: .45rem
	padding: .25rem .7rem
	text-transform: capitalize
}
.sw-dot {
	animation: dashpulse 2s ease-in-out infinite
	border-radius: 50%
	height: 8px
	width: 8px
}
.sw-pill.online .sw-dot: background: $success
.sw-pill.offline .sw-dot: background: $error
@keyframes dashpulse {
	0%, 100%: opacity: 1
	50%: opacity: .35
}
.sw-tile {
	align-items: center
	background: $bg
	border: 1px solid $border
	border-radius: 10px
	display: flex
	gap: .75rem
	padding: .75rem
}
.sw-tile .ic: color: $success
.sw-tile-label {
	color: $muted
	font-size: .75rem
}
.sw-tile-val {
	color: $text
	font-weight: 600
}
.sw-bars {
	display: flex
	flex-direction: column
	gap: 1rem
}
.pb-top {
	align-items: center
	color: $muted
	display: flex
	font-size: .85rem
	justify-content: space-between
	margin-bottom: .4rem
}
.pb-label {
	align-items: center
	display: flex
	gap: .4rem
}
.pb-right {
	align-items: baseline
	display: flex
	gap: .5rem
}
.pb-detail {
	color: $muted
	font-family: monospace
	font-size: .78em
}
.pb-val {
	color: $text
	font-weight: 600
}
.pb-track {
	background: color-mix(in srgb, $surface 75%, $text)
	border-radius: 999px
	height: 8px
	overflow: hidden
}
.pb-fill {
	background: $primary
	border-radius: 999px
	height: 100%
	transition: width .5s ease-in-out
}
.pb.mid .pb-fill: background: $warn
.pb.high .pb-fill: background: $error
.pb.disk .pb-fill: background: #a855f7
.st-card {
	gap: 0
	overflow: hidden
	padding: 0
}
.st-head {
	align-items: center
	background: color-mix(in srgb, $surface 92%, $text)
	border-bottom: 1px solid $border
	display: flex
	gap: .5rem
	justify-content: space-between
	padding: 1.1rem 1.25rem
}
.st-title {
	align-items: center
	color: $text
	display: flex
	font-size: 1.2rem
	font-weight: 700
	gap: .5rem
	margin: 0
}
.st-badge {
	background: color-mix(in srgb, $primary 20%, transparent)
	border-radius: 999px
	color: $primary
	font-size: .72rem
	font-weight: 600
	padding: .2rem .6rem
}
.st-scroll {
	overflow-x: auto
}
.st-card table {
	border-collapse: collapse
	width: 100%
}
.st-card th {
	color: $muted
	font-size: .72rem
	font-weight: 500
	letter-spacing: .05em
	padding: .8rem 1rem
	text-align: left
	text-transform: uppercase
	white-space: nowrap
}
.st-card th.c: text-align: center
.st-card td {
	border-top: 1px solid color-mix(in srgb, $border 60%, transparent)
	padding: .7rem 1rem
	vertical-align: middle
}
.st-card td.c: text-align: center
.st-card tbody tr: transition: background .15s ease
.st-card tbody tr:hover: background: color-mix(in srgb, $surface 88%, $text)
.app-link {
	align-items: center
	color: $text
	display: flex
	font-weight: 600
	gap: .6rem
	text-decoration: none
	white-space: nowrap
}
.app-link:hover .app-label: color: $primary
.vis {
	align-items: center
	color: $muted
	display: inline-flex
	gap: .4rem
	justify-content: center
}
.vis-num {
	color: $text
	font-family: monospace
}
.ping-box {
	align-items: stretch
	background: $bg
	border: 1px solid $border
	border-radius: 10px
	display: inline-flex
	gap: .75rem
	justify-content: center
	padding: .5rem .75rem
}
.ping-div {
	background: $border
	width: 1px
}
.ping {
	align-items: center
	color: $text
	display: flex
	flex-direction: column
	gap: .15rem
	min-width: 66px
	text-decoration: none
}
.ping-label {
	color: $muted
	font-size: .62rem
	letter-spacing: .06em
}
.ping-main {
	align-items: center
	display: flex
	font-family: monospace
	font-size: .85rem
	font-weight: 600
	gap: .25rem
}
.ping-main.up: color: $success
.ping-main.auth: color: $primary
.ping-main.warn: color: $warn
.ping-main.down: color: $error
.ping-main.empty {
	color: $muted
	opacity: .4
}
.ping-ms {
	color: $muted
	font-family: monospace
	font-size: .65rem
}
.st-dot {
	border-radius: 50%
	display: inline-block
	flex-shrink: 0
	height: 8px
	width: 8px
}
.st-dot.up: background: $success
.st-dot.auth: background: $primary
.st-dot.warn: background: $warn
.st-dot.down: background: $error
.ping-code: line-height: 1
.err-badge {
	align-items: center
	background: color-mix(in srgb, $error 20%, transparent)
	border-radius: 999px
	color: $error
	display: inline-flex
	font-weight: 700
	gap: .3rem
	padding: .15rem .6rem
}
.err-zero {
	color: $muted
	font-family: monospace
	opacity: .5
}
.ov-offline {
	color: $muted
	padding: 1rem 0
}
.srv-card {
	background: $surface
	border: 1px solid $border
	border-radius: 12px
	box-shadow: 0 6px 18px #0005
	overflow: hidden
}
.srv-card.off: opacity: .55
.srv-sum {
	cursor: pointer
	display: flex
	flex-direction: column
	gap: 1rem
	list-style: none
	padding: 1.1rem 1.25rem
}
.srv-sum::-webkit-details-marker: display: none
.srv-sum:hover: background: color-mix(in srgb, $surface 93%, $text)
.srv-head {
	align-items: center
	display: flex
	gap: .5rem
	justify-content: space-between
}
.srv-id {
	align-items: center
	display: flex
	gap: .6rem
}
.srv-chev {
	border-bottom: 5px solid transparent
	border-left: 6px solid $muted
	border-top: 5px solid transparent
	flex-shrink: 0
	height: 0
	transition: transform .15s ease
	width: 0
}
details[open] .srv-chev: transform: rotate(90deg)
.srv-right {
	align-items: center
	color: $muted
	display: flex
	flex-wrap: wrap
	font-size: .82rem
	gap: 1rem
	justify-content: flex-end
}
.srv-stat {
	align-items: center
	display: inline-flex
	gap: .35rem
}
.srv-grid {
	display: grid
	gap: 1.25rem 1.75rem
	grid-template-columns: repeat(auto-fit, minmax(240px, 1fr))
}
.srv-col {
	display: flex
	flex-direction: column
	gap: .65rem
	min-width: 0
}
.srv-coltitle {
	color: $muted
	font-size: .72rem
	font-weight: 700
	letter-spacing: .05em
	text-transform: uppercase
}
.srv-coltitle.bad: color: $error
.srv-muted: color: $muted
.sdots {
	display: flex
	flex-wrap: wrap
	gap: 5px
}
.sdot {
	border-radius: 50%
	height: 11px
	transition: transform .1s ease
	width: 11px
}
.sdot:hover: transform: scale(1.4)
.sdot.up: background: $success
.sdot.auth: background: $primary
.sdot.warn: background: $warn
.sdot.down: background: $error
.scounts {
	display: flex
	flex-wrap: wrap
	font-size: .8rem
	gap: .85rem
}
.scount {
	align-items: center
	color: $muted
	display: inline-flex
	gap: .3rem
}
.scount.down: color: $error
.serr-list {
	display: flex
	flex-direction: column
	gap: .3rem
}
.serr-row {
	display: flex
	font-size: .82rem
	gap: .75rem
	justify-content: space-between
}
.serr-app {
	overflow: hidden
	text-overflow: ellipsis
	white-space: nowrap
}
.serr-n {
	color: $error
	flex-shrink: 0
	font-family: monospace
	font-weight: 600
}
.serr-none {
	align-items: center
	color: $success
	display: flex
	font-size: .82rem
	gap: .35rem
}
.srv-body {
	border-top: 1px solid $border
	display: flex
	flex-direction: column
	gap: 1rem
	padding: 1.1rem 1.25rem
}
.srv-body .st-card {
	background: transparent
	border: none
	box-shadow: none
	padding: 0
}
.mg-actions {
	border-top: 1px solid color-mix(in srgb, $border 60%, transparent)
	display: flex
	flex-wrap: wrap
	gap: .5rem
	padding-top: .9rem
}
.mg-btn {
	background: $bg
	border: 1px solid $border
	border-radius: 8px
	color: $muted
	cursor: pointer
	font-size: .76rem
	padding: .35rem .7rem
	transition: border-color .15s ease, color .15s ease
}
.mg-btn:hover {
	border-color: $primary
	color: $primary
}
.err-reset {
	background: transparent
	border: 1px solid $border
	border-radius: 5px
	color: $muted
	cursor: pointer
	font-size: .68rem
	line-height: 1
	margin-left: .4rem
	padding: .1rem .3rem
}
.err-reset:hover {
	border-color: $error
	color: $error
}
</style>
